//* ===== TARHNA HERO ===== */

.tarhna-header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  background: rgba(5, 8, 20, 0.82);
  border-bottom: 1px solid rgba(139, 92, 246, 0.15);
  backdrop-filter: blur(18px);
}

.header-inner {
  width: min(1180px, calc(100% - 32px));
  height: 76px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  direction: rtl;
}

.brand {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.brand img {
  width: 125px;
  height: auto;
  object-fit: contain;
}

.desktop-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 27px;
  flex: 1;
}

.desktop-nav a {
  color: #d9dbea;
  text-decoration: none;
  font-size: 14px;
  transition: 0.25s ease;
}

.desktop-nav a:hover {
  color: #a855f7;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.account-btn {
  color: #fff;
  text-decoration: none;
  border: 1px solid rgba(168, 85, 247, 0.55);
  background: rgba(124, 58, 237, 0.09);
  padding: 10px 18px;
  border-radius: 12px;
  font-size: 13px;
  transition: 0.25s;
}

.account-btn:hover {
  background: rgba(124, 58, 237, 0.2);
  box-shadow: 0 0 24px rgba(124, 58, 237, 0.2);
}

.mobile-menu {
  display: none;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: white;
  font-size: 20px;
}


/* HERO */

.hero {
  position: relative;
  overflow: hidden;
  min-height: 620px;
  background:
    radial-gradient(
      circle at 80% 30%,
      rgba(98, 49, 210, 0.22),
      transparent 35%
    ),
    radial-gradient(
      circle at 15% 60%,
      rgba(0, 119, 255, 0.1),
      transparent 35%
    ),
    linear-gradient(135deg, #050714 0%, #080b18 50%, #050610 100%);
  border-bottom: 1px solid rgba(139, 92, 246, 0.12);
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.2;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 45px 45px;
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
}

.hero-glow-one {
  width: 400px;
  height: 400px;
  background: rgba(130, 50, 255, 0.16);
  right: -120px;
  top: 40px;
}

.hero-glow-two {
  width: 320px;
  height: 320px;
  background: rgba(0, 98, 255, 0.11);
  left: -120px;
  bottom: -80px;
}

.hero-inner {
  position: relative;
  z-index: 2;
  width: min(1180px, calc(100% - 32px));
  min-height: 620px;
  margin: auto;
  display: grid;
  grid-template-columns: 1fr 1.08fr;
  align-items: center;
  gap: 60px;
  padding: 55px 0;
}

.hero-content {
  position: relative;
  z-index: 5;
}

.hero-badge {
  display: inline-flex;
  padding: 8px 14px;
  margin-bottom: 18px;
  border: 1px solid rgba(168, 85, 247, 0.25);
  border-radius: 999px;
  color: #c084fc;
  background: rgba(124, 58, 237, 0.08);
  font-size: 13px;
}

.hero h1 {
  margin: 0;
  color: #fff;
  font-size: clamp(42px, 5vw, 70px);
  line-height: 1.25;
  letter-spacing: -2px;
  font-weight: 900;
}

.hero h1 span {
  display: block;
  background: linear-gradient(
    90deg,
    #b94cff,
    #8b5cf6,
    #2f9dff
  );
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero-description {
  max-width: 570px;
  margin: 24px 0 0;
  color: #aeb4c7;
  font-size: 16px;
  line-height: 2;
}

.hero-buttons {
  display: flex;
  gap: 14px;
  margin-top: 30px;
}

.primary-btn,
.secondary-btn {
  min-height: 52px;
  padding: 0 25px;
  border-radius: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  text-decoration: none;
  font-size: 14px;
  font-weight: 700;
  transition: 0.3s ease;
}

.primary-btn {
  color: white;
  background: linear-gradient(100deg, #6d28d9, #9333ea, #6d28d9);
  box-shadow:
    0 10px 35px rgba(124, 58, 237, 0.25),
    inset 0 1px rgba(255,255,255,0.25);
}

.primary-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 15px 45px rgba(124, 58, 237, 0.4);
}

.secondary-btn {
  color: #e4e7f0;
  border: 1px solid rgba(255,255,255,0.16);
  background: rgba(255,255,255,0.025);
}

.secondary-btn:hover {
  border-color: rgba(168,85,247,.5);
  background: rgba(124,58,237,.08);
}


/* FEATURES */

.hero-features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  margin-top: 38px;
}

.hero-features > div {
  display: flex;
  align-items: center;
  gap: 9px;
}

.hero-features b {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: #c084fc;
  border: 1px solid rgba(168,85,247,.25);
  background: rgba(124,58,237,.08);
}

.hero-features span {
  color: #777f94;
  font-size: 10px;
  line-height: 1.6;
}

.hero-features strong {
  display: block;
  color: #e7e9f1;
  font-size: 11px;
}


/* MONITOR */

.hero-visual {
  position: relative;
  min-height: 440px;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1100px;
}

.monitor {
  position: relative;
  width: min(100%, 570px);
  transform:
    perspective(1000px)
    rotateY(-5deg)
    rotateX(2deg);
}

.monitor-screen {
  position: relative;
  height: 335px;
  overflow: hidden;
  border-radius: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px solid rgba(150, 90, 255, 0.55);
  background:
    radial-gradient(
      circle at center,
      rgba(100, 45, 220, 0.28),
      transparent 48%
    ),
    linear-gradient(145deg, #080b19, #0b1027);
  box-shadow:
    0 0 0 6px rgba(255,255,255,.025),
    0 0 35px rgba(128,52,255,.25),
    0 25px 70px rgba(0,0,0,.6),
    inset 0 0 45px rgba(95,44,190,.18);
}

.monitor-screen::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      120deg,
      transparent 20%,
      rgba(255,255,255,.05) 40%,
      transparent 55%
    );
  pointer-events: none;
}

.screen-glow {
  position: absolute;
  width: 300px;
  height: 180px;
  border-radius: 50%;
  background: rgba(120, 50, 255, .28);
  filter: blur(65px);
}

.monitor-screen img {
  position: relative;
  z-index: 3;
  width: 68%;
  height: auto;
  object-fit: contain;
  filter:
    drop-shadow(0 0 8px rgba(200,50,255,.55))
    drop-shadow(0 0 18px rgba(30,120,255,.35));
}

.screen-line {
  position: relative;
  z-index: 3;
  width: 100px;
  height: 1px;
  margin: 15px 0 10px;
  background: linear-gradient(
    90deg,
    transparent,
    #a855f7,
    transparent
  );
}

.monitor-screen p {
  position: relative;
  z-index: 3;
  margin: 0;
  color: #aeb4ca;
  font-size: 13px;
}

.monitor-neck {
  width: 75px;
  height: 50px;
  margin: -1px auto 0;
  background: linear-gradient(
    90deg,
    #11152a,
    #252b48,
    #11152a
  );
  border-left: 1px solid rgba(255,255,255,.1);
  border-right: 1px solid rgba(255,255,255,.1);
}

.monitor-base {
  width: 210px;
  height: 14px;
  margin: auto;
  border-radius: 50%;
  background: linear-gradient(90deg, #101426, #30375b, #101426);
  box-shadow: 0 10px 35px rgba(104, 50, 255, .22);
}


/* FLOATING CARDS */

.floating-card {
  position: absolute;
  z-index: 5;
  padding: 12px 16px;
  border-radius: 13px;
  color: #d8dbea;
  font-size: 12px;
  background: rgba(14,18,38,.75);
  border: 1px solid rgba(160,100,255,.2);
  backdrop-filter: blur(12px);
  box-shadow: 0 15px 35px rgba(0,0,0,.3);
}

.card-one {
  right: 0;
  bottom: 85px;
}

.card-one span {
  color: #c084fc;
}

.card-two {
  left: 0;
  top: 80px;
  color: #9ba3ba;
}


/* ===== MOBILE ===== */

@media (max-width: 900px) {

  .header-inner {
    height: 66px;
    width: calc(100% - 24px);
  }

  .desktop-nav,
  .account-btn {
    display: none;
  }

  .mobile-menu {
    display: block;
  }

  .brand img {
    width: 105px;
  }

  .hero {
    min-height: auto;
  }

  .hero-inner {
    width: calc(100% - 28px);
    min-height: auto;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 25px 0 45px;
  }

  .hero-visual {
    order: -1;
    min-height: 265px;
  }

  .monitor {
    width: min(100%, 390px);
    transform: none;
  }

  .monitor-screen {
    height: 220px;
    border-radius: 18px;
  }

  .monitor-neck {
    height: 28px;
    width: 52px;
  }

  .monitor-base {
    width: 140px;
    height: 9px;
  }

  .floating-card {
    display: none;
  }

  .hero-content {
    text-align: center;
  }

  .hero-badge {
    margin-bottom: 13px;
  }

  .hero h1 {
    font-size: clamp(34px, 10vw, 48px);
    letter-spacing: -1px;
  }

  .hero-description {
    margin: 16px auto 0;
    max-width: 470px;
    font-size: 14px;
    line-height: 1.9;
  }

  .hero-buttons {
    flex-direction: column;
    margin-top: 23px;
  }

  .primary-btn,
  .secondary-btn {
    width: 100%;
  }

  .hero-features {
    grid-template-columns: repeat(2, 1fr);
    margin-top: 28px;
    gap: 16px 8px;
    text-align: right;
  }

  .hero-features > div {
    justify-content: center;
  }
}

@media (max-width: 420px) {

  .hero-inner {
    width: calc(100% - 22px);
  }

  .hero-visual {
    min-height: 235px;
  }

  .monitor-screen {
    height: 195px;
  }

  .monitor-screen img {
    width: 72%;
  }

  .hero h1 {
    font-size: 34px;
  }

  .hero-features b {
    width: 31px;
    height: 31px;
  }
}
/* ========================================
   TARHNA INTERACTIVE MONITOR + LOGO MOTION
   ======================================== */

/* لوگوی هدر: بدون دایره و قاب */
.brand {
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: visible !important;
}

.brand img {
  width: 145px;
  height: auto;
  border: 0 !important;
  border-radius: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  filter:
    drop-shadow(0 0 5px rgba(174, 60, 255, 0.55))
    drop-shadow(0 0 10px rgba(38, 130, 255, 0.35));
}

/* هدر واضح‌تر */
.tarhna-header {
  background:
    linear-gradient(
      90deg,
      rgba(8, 8, 24, 0.97),
      rgba(20, 10, 43, 0.96),
      rgba(7, 12, 29, 0.97)
    ) !important;

  border-bottom: 1px solid rgba(174, 74, 255, 0.35);

  box-shadow:
    0 8px 35px rgba(0, 0, 0, 0.35),
    0 1px 18px rgba(126, 45, 255, 0.14);
}

/* نور پشت مانیتور */
.desk-glow {
  position: absolute;
  width: 82%;
  height: 65%;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  pointer-events: none;

  background:
    radial-gradient(
      ellipse,
      rgba(125, 45, 255, 0.25) 0%,
      rgba(31, 96, 255, 0.10) 42%,
      transparent 72%
    );

  filter: blur(35px);
}

/* خود مانیتور */
.monitor {
  z-index: 3;
}

.monitor-screen {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  padding: 0;
  color: inherit;
  font: inherit;
  cursor: pointer;
  outline: none;

  transition:
    background 0.65s ease,
    border-color 0.65s ease,
    box-shadow 0.65s ease,
    transform 0.25s ease;
}

.monitor-screen:active {
  transform: scale(0.992);
}

/* مانیتور روشن */
.monitor-screen.monitor-on {
  background:
    radial-gradient(
      circle at 50% 48%,
      rgba(115, 45, 225, 0.34),
      rgba(24, 18, 60, 0.75) 42%,
      #070a17 78%
    );

  border-color: rgba(166, 79, 255, 0.8);

  box-shadow:
    0 0 0 5px rgba(255, 255, 255, 0.025),
    0 0 22px rgba(164, 63, 255, 0.45),
    0 0 70px rgba(85, 51, 255, 0.24),
    0 30px 75px rgba(0, 0, 0, 0.65),
    inset 0 0 70px rgba(100, 44, 210, 0.25);
}

/* مانیتور خاموش */
.monitor-screen.monitor-off {
  background:
    radial-gradient(
      circle at 50% 40%,
      #10121a 0%,
      #07080c 48%,
      #020203 100%
    );

  border-color: rgba(80, 84, 105, 0.5);

  box-shadow:
    0 0 0 5px rgba(255, 255, 255, 0.018),
    0 22px 60px rgba(0, 0, 0, 0.72),
    inset 0 0 50px rgba(255, 255, 255, 0.018);
}

/* انعکاس شیشه مانیتور */
.screen-reflection {
  position: absolute;
  inset: 0;
  z-index: 5;
  pointer-events: none;
  opacity: 0.4;

  background:
    linear-gradient(
      118deg,
      transparent 15%,
      rgba(255, 255, 255, 0.045) 35%,
      transparent 51%
    );
}

/* محفظه موشن لوگو */
.logo-motion {
  position: relative;
  z-index: 4;
  width: 100%;
  height: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  animation: screenBoot 2.25s ease-out both;
}

/* لوگوی روی مانیتور */
.logo-motion img {
  position: relative;
  z-index: 4;

  width: 69%;
  height: auto;

  opacity: 0;

  filter:
    brightness(1.12)
    contrast(1.12)
    drop-shadow(0 0 5px rgba(255, 37, 239, 0.75))
    drop-shadow(0 0 12px rgba(131, 43, 255, 0.85))
    drop-shadow(0 0 24px rgba(30, 134, 255, 0.55));

  animation: tarhnaLogoReveal 2.15s ease-out forwards;
}

/* نور انفجاری پشت لوگو */
.logo-energy {
  position: absolute;
  z-index: 1;

  width: 65%;
  height: 42%;

  border-radius: 50%;

  background:
    radial-gradient(
      ellipse,
      rgba(188, 48, 255, 0.5) 0%,
      rgba(77, 83, 255, 0.28) 38%,
      transparent 72%
    );

  filter: blur(35px);

  opacity: 0;

  animation: energyReveal 2.1s ease-out forwards;
}

/* خط نور زیر لوگو */
.screen-light-line {
  position: relative;
  z-index: 4;

  display: block;

  width: 0;
  height: 2px;

  margin: 13px 0 11px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #387cff,
      #d33cff,
      #387cff,
      transparent
    );

  box-shadow:
    0 0 10px rgba(167, 62, 255, 0.8),
    0 0 20px rgba(45, 120, 255, 0.55);

  animation: lightLineReveal 1.15s 1.05s ease forwards;
}

.logo-motion p {
  position: relative;
  z-index: 4;

  margin: 0;

  color: #d9d8e7;
  font-size: 13px;
  letter-spacing: 0;

  opacity: 0;

  text-shadow:
    0 0 12px rgba(168, 85, 247, 0.45);

  animation: taglineReveal 0.8s 1.45s ease forwards;
}

/* نقطه پاور در حالت خاموش */
.power-dot {
  position: absolute;
  right: 17px;
  bottom: 13px;

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #525666;

  box-shadow: 0 0 4px rgba(255, 255, 255, 0.12);
}

/* راهنمای لمس */
.monitor-hint {
  position: absolute;
  z-index: 7;

  bottom: 18px;
  left: 50%;
  transform: translateX(-50%);

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  width: max-content;
  max-width: 90%;

  padding: 8px 13px;

  color: rgba(210, 211, 226, 0.72);
  font-size: 10px;

  border: 1px solid rgba(158, 80, 255, 0.15);
  border-radius: 999px;

  background: rgba(8, 10, 25, 0.6);
  backdrop-filter: blur(8px);

  pointer-events: none;
}

.monitor-hint span {
  color: #9f52ff;
  font-size: 7px;

  animation: hintPulse 1.8s infinite;
}


/* ===== LOGO MOTION ===== */

@keyframes screenBoot {
  0% {
    opacity: 0;
    filter: brightness(0);
  }

  12% {
    opacity: 1;
    filter: brightness(0.15);
  }

  18% {
    filter: brightness(1.7);
  }

  23% {
    filter: brightness(0.4);
  }

  32% {
    filter: brightness(1.2);
  }

  100% {
    opacity: 1;
    filter: brightness(1);
  }
}

@keyframes tarhnaLogoReveal {
  0% {
    opacity: 0;
    transform: scale(0.88);
    filter:
      brightness(3)
      blur(8px)
      drop-shadow(0 0 30px rgba(168, 40, 255, 1));
  }

  25% {
    opacity: 0;
  }

  42% {
    opacity: 0.35;
    transform: scale(0.94);
  }

  58% {
    opacity: 1;
    transform: scale(1.035);
  }

  72% {
    transform: scale(0.99);
  }

  100% {
    opacity: 1;
    transform: scale(1);

    filter:
      brightness(1.12)
      contrast(1.12)
      drop-shadow(0 0 5px rgba(255, 37, 239, 0.75))
      drop-shadow(0 0 12px rgba(131, 43, 255, 0.85))
      drop-shadow(0 0 24px rgba(30, 134, 255, 0.55));
  }
}

@keyframes energyReveal {
  0%,
  25% {
    opacity: 0;
    transform: scale(0.5);
  }

  52% {
    opacity: 0.95;
    transform: scale(1.12);
  }

  100% {
    opacity: 0.52;
    transform: scale(1);
  }
}

@keyframes lightLineReveal {
  from {
    width: 0;
    opacity: 0;
  }

  to {
    width: 105px;
    opacity: 1;
  }
}

@keyframes taglineReveal {
  from {
    opacity: 0;
    transform: translateY(7px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes hintPulse {
  0%,
  100% {
    opacity: 0.35;
    box-shadow: 0 0 0 rgba(159, 82, 255, 0);
  }

  50% {
    opacity: 1;
    box-shadow: 0 0 9px rgba(159, 82, 255, 0.8);
  }
}


/* ===== MOBILE IMPROVEMENTS ===== */

@media (max-width: 900px) {

  .brand img {
    width: 120px;
  }

  .hero-visual {
    min-height: 300px;
  }

  .monitor {
    width: min(96%, 410px);
  }

  .monitor-screen {
    height: 230px;
  }

  .logo-motion img {
    width: 72%;
  }

  .desk-glow {
    width: 105%;
    height: 80%;
    opacity: 0.9;
  }

  .monitor-hint {
    bottom: 3px;
    font-size: 9px;
  }
}

@media (max-width: 420px) {

  .brand img {
    width: 112px;
  }

  .hero-visual {
    min-height: 275px;
  }

  .monitor {
    width: 96%;
  }

  .monitor-screen {
    height: 205px;
  }

  .logo-motion img {
    width: 76%;
  }

  .logo-motion p {
    font-size: 11px;
  }

  .screen-light-line {
    margin: 9px 0 8px;
  }

  .monitor-hint {
    bottom: 1px;
    padding: 6px 10px;
    font-size: 8px;
  }
}

/* احترام به تنظیم کاهش انیمیشن کاربر */
@media (prefers-reduced-motion: reduce) {

  .logo-motion,
  .logo-motion img,
  .logo-energy,
  .screen-light-line,
  .logo-motion p,
  .monitor-hint span {
    animation-duration: 0.01ms !important;
    animation-delay: 0ms !important;
  }
}
/* ===== TARHNA CINEMATIC BOOT UPGRADE ===== */

.monitor-on::before {
  content: "";
  position: absolute;
  z-index: 20;
  left: 5%;
  right: 5%;
  top: 50%;
  height: 2px;
  pointer-events: none;

  background: linear-gradient(
    90deg,
    transparent,
    #3b82f6,
    #ffffff,
    #d946ef,
    transparent
  );

  box-shadow:
    0 0 8px #ffffff,
    0 0 18px rgba(59, 130, 246, .95),
    0 0 35px rgba(217, 70, 239, .8);

  opacity: 0;
  transform: scaleX(0);
  animation: tarhnaBootScan 1.15s ease-out forwards;
}

.monitor-on::after {
  content: "";
  position: absolute;
  z-index: 19;
  inset: 0;
  pointer-events: none;

  background: radial-gradient(
    ellipse at center,
    rgba(255,255,255,.42) 0%,
    rgba(158,70,255,.22) 18%,
    rgba(47,128,255,.12) 38%,
    transparent 68%
  );

  opacity: 0;
  animation: tarhnaBootFlash 1.55s ease-out forwards;
}

.logo-motion img {
  animation: tarhnaCinematicLogo 2.25s cubic-bezier(.16,.8,.25,1) forwards;
}

.logo-energy {
  animation: tarhnaEnergyPulse 2.5s ease-out forwards;
}

@keyframes tarhnaBootScan {
  0% {
    opacity: 0;
    transform: scaleX(.02);
  }

  18% {
    opacity: 1;
    transform: scaleX(.08);
  }

  48% {
    opacity: 1;
    transform: scaleX(1);
  }

  68% {
    opacity: .8;
    transform: scaleX(.92);
  }

  100% {
    opacity: 0;
    transform: scaleX(1);
  }
}

@keyframes tarhnaBootFlash {
  0%,
  20% {
    opacity: 0;
  }

  38% {
    opacity: .18;
  }

  48% {
    opacity: .9;
  }

  58% {
    opacity: .12;
  }

  72% {
    opacity: .35;
  }

  100% {
    opacity: 0;
  }
}

@keyframes tarhnaCinematicLogo {
  0%,
  27% {
    opacity: 0;
    transform: scale(.82);
    filter:
      brightness(0)
      blur(10px);
  }

  40% {
    opacity: .18;
    transform: scale(.9);
    filter:
      brightness(3)
      blur(6px)
      drop-shadow(0 0 35px rgba(179,60,255,1));
  }

  53% {
    opacity: 1;
    transform: scale(1.06);
    filter:
      brightness(1.8)
      blur(0)
      drop-shadow(0 0 12px rgba(255,55,240,.95))
      drop-shadow(0 0 30px rgba(74,112,255,.9));
  }

  66% {
    transform: scale(.985);
  }

  78% {
    transform: scale(1.015);
  }

  100% {
    opacity: 1;
    transform: scale(1);
    filter:
      brightness(1.15)
      contrast(1.12)
      drop-shadow(0 0 6px rgba(255,37,239,.8))
      drop-shadow(0 0 14px rgba(131,43,255,.85))
      drop-shadow(0 0 26px rgba(30,134,255,.6));
  }
}

@keyframes tarhnaEnergyPulse {
  0%,
  30% {
    opacity: 0;
    transform: scale(.35);
  }

  50% {
    opacity: 1;
    transform: scale(1.3);
  }

  67% {
    opacity: .38;
    transform: scale(.92);
  }

  82% {
    opacity: .7;
    transform: scale(1.08);
  }

  100% {
    opacity: .5;
    transform: scale(1);
  }
}

/* Remove boot scan line */
.monitor-on::before {
  display: none !important;
}

/* ===== TARHNA SOFT LOGO REVEAL - FINAL ===== */

/* حذف کامل خط اسکن */
.monitor-on::before {
  display: none !important;
  content: none !important;
  animation: none !important;
}

/* نور بسیار ملایم هنگام روشن شدن مانیتور */
.monitor-on::after {
  content: "";
  position: absolute;
  z-index: 2;
  inset: 0;
  pointer-events: none;

  background:
    radial-gradient(
      ellipse at center,
      rgba(146, 72, 255, 0.18) 0%,
      rgba(72, 93, 255, 0.10) 30%,
      rgba(24, 15, 70, 0.05) 52%,
      transparent 72%
    );

  opacity: 0;
  animation: tarhnaSoftLight 2.8s ease-out forwards !important;
}

/* ورود آرام لوگو */
.logo-motion img {
  opacity: 0;
  transform: scale(0.94);

  animation:
    tarhnaSoftLogoReveal 3s cubic-bezier(.22,.7,.25,1)
    forwards !important;
}

/* هاله پشت لوگو */
.logo-energy {
  opacity: 0;

  animation:
    tarhnaSoftEnergy 3.2s ease-out
    forwards !important;
}


/* نور مانیتور بدون فلش */
@keyframes tarhnaSoftLight {

  0% {
    opacity: 0;
  }

  20% {
    opacity: 0.08;
  }

  48% {
    opacity: 0.35;
  }

  72% {
    opacity: 0.58;
  }

  100% {
    opacity: 0.42;
  }
}


/* ظاهر شدن نرم و آهسته لوگو */
@keyframes tarhnaSoftLogoReveal {

  0% {
    opacity: 0;
    transform: scale(0.94);
    filter:
      brightness(0.25)
      blur(7px);
  }

  22% {
    opacity: 0.05;
    transform: scale(0.95);
    filter:
      brightness(0.4)
      blur(6px);
  }

  48% {
    opacity: 0.38;
    transform: scale(0.975);
    filter:
      brightness(0.75)
      blur(3px)
      drop-shadow(0 0 8px rgba(133, 68, 255, 0.35));
  }

  72% {
    opacity: 0.78;
    transform: scale(0.992);
    filter:
      brightness(1)
      blur(1px)
      drop-shadow(0 0 10px rgba(192, 53, 255, 0.50))
      drop-shadow(0 0 18px rgba(46, 120, 255, 0.35));
  }

  100% {
    opacity: 1;
    transform: scale(1);
    filter:
      brightness(1.12)
      blur(0)
      drop-shadow(0 0 7px rgba(230, 52, 255, 0.65))
      drop-shadow(0 0 15px rgba(133, 55, 255, 0.60))
      drop-shadow(0 0 24px rgba(35, 126, 255, 0.38));
  }
}


/* هاله‌ای که آرام همراه لوگو شکل می‌گیرد */
@keyframes tarhnaSoftEnergy {

  0% {
    opacity: 0;
    transform: scale(0.82);
  }

  35% {
    opacity: 0.05;
    transform: scale(0.90);
  }

  65% {
    opacity: 0.28;
    transform: scale(0.98);
  }

  100% {
    opacity: 0.42;
    transform: scale(1);
  }
}


/* ===== TARHNA ULTRA SMOOTH REVEAL ===== */

.monitor-on::before {
  display: none !important;
  content: none !important;
}

/* نور محیطی آرام */
.monitor-on::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;

  background: radial-gradient(
    ellipse at center,
    rgba(145, 70, 255, 0.17) 0%,
    rgba(62, 91, 255, 0.09) 35%,
    transparent 70%
  );

  opacity: 0;
  animation: tarhnaAmbientSmooth 2.8s ease-in-out forwards !important;
}

/* لوگو */
.logo-motion img {
  opacity: 0;
  transform: scale(0.97);
  filter: brightness(0.65);

  animation: tarhnaLogoSmooth 2.6s
    cubic-bezier(0.16, 1, 0.3, 1)
    forwards !important;

  will-change: opacity, transform, filter;
}

/* نور پشت لوگو */
.logo-energy {
  opacity: 0;
  transform: scale(0.95);

  animation: tarhnaEnergySmooth 3s
    cubic-bezier(0.16, 1, 0.3, 1)
    forwards !important;
}

@keyframes tarhnaLogoSmooth {
  from {
    opacity: 0;
    transform: scale(0.97);
    filter:
      brightness(0.65)
      drop-shadow(0 0 0 rgba(185, 55, 255, 0));
  }

  to {
    opacity: 1;
    transform: scale(1);
    filter:
      brightness(1.1)
      drop-shadow(0 0 8px rgba(225, 55, 255, 0.60))
      drop-shadow(0 0 16px rgba(125, 60, 255, 0.50))
      drop-shadow(0 0 24px rgba(40, 125, 255, 0.30));
  }
}

@keyframes tarhnaAmbientSmooth {
  from {
    opacity: 0;
  }

  to {
    opacity: 0.48;
  }
}

@keyframes tarhnaEnergySmooth {
  from {
    opacity: 0;
    transform: scale(0.95);
  }

  to {
    opacity: 0.40;
    transform: scale(1);
  }
}

