"use client";

import Image from "next/image";
import Link from "next/link";
import { useState } from "react";
import "./Hero.css";

export default function Hero() {
  const [monitorOn, setMonitorOn] = useState(true);
  const [menuOpen, setMenuOpen] = useState(false);
  const [logoKey, setLogoKey] = useState(0);

  function toggleMonitor() {
    if (monitorOn) {
      setMonitorOn(false);
    } else {
      setMonitorOn(true);
      setLogoKey((key) => key + 1);
    }
  }

  return (
    <>
      <header className="tarhna-header">
        <div className="header-inner">
          <Link href="/" className="brand">
            <Image
              src="/images/tarhna-logo.png"
              alt="طرحنا"
              width={170}
              height={80}
              priority
            />
          </Link>

          <nav className="desktop-nav">
            <Link href="/">صفحه اصلی</Link>
            <Link href="#services">خدمات</Link>
            <Link href="#shop">فروشگاه طرح‌ها</Link>
            <Link href="#sellers">فروشندگان</Link>
            <Link href="#articles">مقالات و آموزش‌ها</Link>
            <Link href="#about">درباره ما</Link>
          </nav>

          <div className="header-actions">
            <Link href="/dashboard" className="account-btn">
              ورود / ثبت‌نام
            </Link>

            <button
              type="button"
              className="mobile-menu"
              onClick={() => setMenuOpen(!menuOpen)}
              aria-label="باز کردن منو"
            >
              ☰
            </button>
          </div>
        </div>

        {menuOpen && (
          <nav className="mobile-nav">
            <Link href="/" onClick={() => setMenuOpen(false)}>
              صفحه اصلی
            </Link>
            <Link href="#services" onClick={() => setMenuOpen(false)}>
              خدمات
            </Link>
            <Link href="#shop" onClick={() => setMenuOpen(false)}>
              فروشگاه طرح‌ها
            </Link>
            <Link href="#sellers" onClick={() => setMenuOpen(false)}>
              فروشندگان
            </Link>
            <Link href="#articles" onClick={() => setMenuOpen(false)}>
              مقالات و آموزش‌ها
            </Link>
            <Link href="#about" onClick={() => setMenuOpen(false)}>
              درباره ما
            </Link>
          </nav>
        )}
      </header>

      <section className="tarhna-hero" dir="rtl">
        <div className="hero-background" />

        <div className="hero-overlay" />

        <div className="hero-inner">
          <div className="hero-content">
            <span className="hero-badge">
              ✦ استودیوی خلاقیت طرحنا
            </span>

            <h1>
              ایده‌ات را بفرست،
              <span> حرفه‌ای تحویل بگیر</span>
            </h1>

            <p className="hero-description">
              خدمات گرافیکی و طراحی با قدرت هوش مصنوعی و خلاقیت انسانی؛
              از افزایش کیفیت و بازطراحی عکس تا طراحی پوستر و تصاویر اختصاصی.
            </p>

            <div className="hero-buttons">
              <Link href="#order" className="primary-btn">
                ثبت سفارش
                <span>↗</span>
              </Link>

              <Link href="#portfolio" className="secondary-btn">
                مشاهده نمونه‌کارها
                <span>▶</span>
              </Link>
            </div>

            <div className="hero-features">
              <div>
                <b>✦</b>
                <span>
                  <strong>کیفیت حرفه‌ای</strong>
                  خروجی باکیفیت
                </span>
              </div>

              <div>
                <b>◷</b>
                <span>
                  <strong>تحویل به‌موقع</strong>
                  طبق زمان توافقی
                </span>
              </div>

              <div>
                <b>◇</b>
                <span>
                  <strong>قیمت مناسب</strong>
                  تعرفه منصفانه
                </span>
              </div>

              <div>
                <b>♡</b>
                <span>
                  <strong>پشتیبانی واقعی</strong>
                  همراه شما
                </span>
              </div>
            </div>
          </div>

          <button
            type="button"
            className={`monitor-hotspot ${monitorOn ? "is-on" : "is-off"}`}
            onClick={toggleMonitor}
            aria-label={monitorOn ? "خاموش کردن مانیتور" : "روشن کردن مانیتور"}
          >
            <span className="monitor-light" />

            {monitorOn && (
              <span key={logoKey} className="monitor-logo">
                <Image
                  src="/images/tarhna-logo.png"
                  alt="لوگوی طرحنا روی مانیتور"
                  width={500}
                  height={230}
                  priority
                />

                <small>ایده‌ها، تصویر می‌شوند</small>
              </span>
            )}

            {!monitorOn && (
              <span className="monitor-off-state">
                <i />
              </span>
            )}
          </button>
        </div>

        <div className="mobile-monitor-hint">
          برای خاموش یا روشن کردن مانیتور، روی آن بزنید
        </div>
      </section>
    </>
  );
}
