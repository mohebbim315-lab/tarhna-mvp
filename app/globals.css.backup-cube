@tailwind base;
@tailwind components;
@tailwind utilities;

:root { color-scheme: dark; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; font-family: Tahoma, Arial, sans-serif; background: #050507; color: #fff; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }

.site { min-height: 100vh; overflow: hidden; position: relative; background: #050507; color: #f7f5ff; }
.site.light { background: #f7f8fc; color: #17151d; color-scheme: light; }
.wrap { width: min(1180px, calc(100% - 40px)); margin-inline: auto; position: relative; z-index: 2; }
.ambient { position: absolute; border-radius: 50%; filter: blur(100px); opacity: .24; pointer-events: none; }
.ambient-one { width: 480px; height: 480px; right: 8%; top: 170px; background: #8a2be2; }
.ambient-two { width: 360px; height: 360px; left: -100px; top: 480px; background: #00bfff; }

.topbar { height: 72px; margin-top: 18px; padding: 8px 10px 8px 16px; display: flex; align-items: center; gap: 18px; border: 1px solid rgba(255,255,255,.09); border-radius: 22px; background: rgba(8,8,13,.74); backdrop-filter: blur(20px); box-shadow: 0 20px 50px rgba(0,0,0,.28); }
.light .topbar { background: rgba(255,255,255,.85); border-color: rgba(20,20,30,.08); box-shadow: 0 12px 40px rgba(30,20,70,.08); }
.brand { flex: 0 0 auto; width: 76px; height: 54px; border: 1px solid rgba(255,255,255,.9); border-radius: 50%; display:flex; align-items:center; justify-content:center; font-weight: 900; font-size: 16px; background:#050507; color:#fff; }
.brand span { color:#e53cff; }
.light .brand { border-color:#222; background:#050507; }
.nav { flex:1; display:flex; justify-content:center; gap: 18px; font-size:12px; color:#a8a5b1; white-space:nowrap; }
.nav a { padding: 10px 7px; transition:.2s; }
.nav a:hover,.nav a.active { color:#fff; }
.light .nav a { color:#696774; }.light .nav a:hover,.light .nav a.active{color:#17151d}
.top-actions { display:flex; align-items:center; gap:8px; }
.theme-switch { border:1px solid rgba(255,255,255,.09); background:#15151e; color:#fff; border-radius:18px; height:36px; padding:0 7px; display:flex; align-items:center; gap:3px; cursor:pointer; }.theme-switch span{width:25px;height:25px;display:grid;place-items:center;border-radius:50%;font-size:13px}.theme-switch span:last-child{background:#2b2b36}.light .theme-switch{background:#f0f0f4;color:#111}.light .theme-switch span:first-child{background:#fff}.credits{font-size:11px;color:#a9a6b4;border:1px solid rgba(255,255,255,.07);border-radius:18px;padding:10px 12px}.credits b{color:#eee}.icon-btn{width:36px;height:36px;border:0;background:transparent;color:#c4c1ca;display:grid;place-items:center}.avatar{width:35px;height:35px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#8d55ff,#1e9fff);border:2px solid rgba(255,255,255,.7);font-weight:900}

.hero { min-height: 510px; display:grid; grid-template-columns: .9fr 1.1fr; align-items:center; gap:20px; padding-top:45px; }
.hero-copy { padding-right: 20px; position:relative; z-index:3; }.eyebrow{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(197,72,255,.25);background:rgba(107,36,141,.12);padding:9px 15px;border-radius:999px;color:#db9cff;font-size:12px}.hero h1{font-size:54px;line-height:1.25;margin:18px 0 12px;font-weight:950;letter-spacing:-2px}.hero h1 em{font-style:normal;background:linear-gradient(90deg,#ff35d6,#8f63ff,#19c9ff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:500px;color:#aaa6b1;line-height:2.1;font-size:13px}.light .hero p{color:#66636e}.hero-actions{display:flex;gap:12px;margin-top:24px}.primary-btn,.secondary-btn{height:46px;border-radius:13px;padding:0 20px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px}.primary-btn{background:linear-gradient(100deg,#ff3bc9,#9d52ff 60%,#438dff);box-shadow:0 12px 35px rgba(176,59,255,.3);font-weight:800}.secondary-btn{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.025)}.light .secondary-btn{border-color:#dddde6;background:#fff}.flip{transform:rotate(180deg)}

.hero-stage{height:470px;position:relative;display:flex;align-items:center;justify-content:center;perspective:1000px}.orbit{position:absolute;border:1px solid rgba(167,77,255,.35);border-radius:50%;transform:rotateX(65deg)}.orbit-a{width:430px;height:190px;bottom:72px}.orbit-b{width:330px;height:145px;bottom:95px;border-color:rgba(53,172,255,.2)}.platform{position:absolute;bottom:67px;width:360px;height:78px;border-radius:50%;background:linear-gradient(#171021,#0b0a10);border:1px solid rgba(180,91,255,.4);box-shadow:0 0 35px rgba(157,58,255,.3),inset 0 0 30px rgba(124,60,255,.25);transform:rotateX(63deg)}.platform:after{content:"";position:absolute;inset:10px;border:3px solid #9250ff;border-radius:50%;box-shadow:0 0 18px #9250ff}.platform-glow{position:absolute;inset:22px;border-radius:50%;background:rgba(151,66,255,.25);filter:blur(10px)}.cube-wrap{position:absolute;bottom:133px;z-index:3;transform:rotateX(4deg) rotateY(-5deg)}.cube{width:165px;height:165px;border-radius:27px;background:linear-gradient(145deg,#28203b,#09090d 60%);border:1px solid rgba(226,203,255,.25);display:grid;place-items:center;box-shadow:inset 0 0 45px rgba(175,65,255,.23),0 20px 45px rgba(0,0,0,.55),0 0 40px rgba(153,55,255,.26);position:relative}.cube:before,.cube:after{content:"";position:absolute;border-radius:20px;inset:11px;border:1px solid rgba(177,93,255,.3)}.cube:after{inset:-10px;border:1px solid rgba(89,190,255,.16);transform:translateZ(-1px)}.cube span{font-size:28px;font-weight:950;text-shadow:0 0 25px #d15cff}.float-card{position:absolute;width:132px;height:174px;border-radius:19px;background-size:cover;background-position:center;border:1px solid rgba(255,255,255,.26);box-shadow:0 22px 35px rgba(0,0,0,.45),0 0 30px rgba(142,54,255,.18)}.float-card:after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(180deg,rgba(122,54,255,.1),rgba(0,0,0,.45))}.card-a{right:18px;top:80px;transform:rotate(13deg)}.card-b{left:35px;top:105px;transform:rotate(-15deg)}.card-c{right:95px;top:15px;width:96px;height:110px;transform:rotate(8deg)}.orb{position:absolute;width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,#a953ff,#2731a9);box-shadow:0 0 20px rgba(151,68,255,.45);transform:rotate(30deg)}.orb-1{right:0;top:125px}.orb-2{left:5px;top:210px}.orb-3{right:45px;bottom:140px}.orb-4{left:70px;bottom:105px;width:19px;height:19px}

.glass-panel{border:1px solid rgba(255,255,255,.1);background:linear-gradient(135deg,rgba(25,23,36,.9),rgba(12,12,18,.78));box-shadow:0 25px 70px rgba(0,0,0,.25);backdrop-filter:blur(18px);border-radius:18px}.light .glass-panel{background:rgba(255,255,255,.84);border-color:#e4e4eb;box-shadow:0 20px 50px rgba(54,40,100,.08)}
.creator{margin-top:-8px;display:grid;grid-template-columns:1.5fr .9fr;gap:20px;padding:18px 20px}.creator h3{font-size:13px;margin:0 0 12px}.prompt-row{display:flex;gap:10px}.prompt-input{height:44px;flex:1;border-radius:10px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.035);color:#76727e;padding:0 18px;display:flex;align-items:center;font-size:11px}.light .prompt-input{background:#f9f9fb;border-color:#e6e5ec}.prompt-submit{width:140px;height:44px;border-radius:10px;display:flex;align-items:center;justify-content:center;gap:7px;background:linear-gradient(100deg,#b94cff,#3b93ff);font-size:11px;font-weight:800}.chips{display:flex;gap:7px;margin-top:13px;overflow:auto}.chips button{white-space:nowrap;border:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.025);color:#98949f;border-radius:999px;padding:7px 11px;font-size:9px}.chips button.selected{background:rgba(166,66,255,.13);border-color:rgba(175,72,255,.35);color:#db9bff}.creator-options{border-right:1px solid rgba(255,255,255,.07);padding-right:20px}.ratio-title{font-size:11px;margin-bottom:8px}.ratios{display:flex;justify-content:space-between}.ratio{display:flex;flex-direction:column;align-items:center;gap:5px;color:#85818d;font-size:8px}.ratio-box{width:31px;height:25px;border:1px solid #6b6874;border-radius:4px}.ratio:nth-child(2) .ratio-box{width:34px;height:20px}.ratio:nth-child(3) .ratio-box{width:19px;height:31px}.ratio:nth-child(4) .ratio-box{width:31px;height:23px}.ratio.selected{color:#e89cff}.ratio.selected .ratio-box{border-color:#d65aff;box-shadow:0 0 15px rgba(204,68,255,.25)}.quality{display:flex;align-items:center;gap:7px;margin-top:13px;font-size:9px;color:#898590}.quality button{border:1px solid rgba(255,255,255,.07);background:transparent;color:#aaa6b1;border-radius:8px;padding:7px 12px;font-size:9px}.quality button.selected{border-color:#b94cff;color:#df9aff;background:rgba(165,65,255,.09)}

.services{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:18px}.service-card{min-height:112px;border-radius:12px;border:1px solid rgba(255,255,255,.07);background:rgba(14,14,22,.84);padding:14px 10px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;transition:.2s}.light .service-card{background:#fff;border-color:#e5e4eb}.service-card:hover{transform:translateY(-4px);border-color:rgba(186,77,255,.45);box-shadow:0 18px 40px rgba(117,39,170,.16)}.service-icon{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:rgba(175,64,255,.12);color:#d45cff;box-shadow:inset 0 0 18px rgba(162,64,255,.14)}.service-card.gold .service-icon{color:#ffc94b;background:rgba(255,193,55,.1)}.service-card.blue .service-icon{color:#68a7ff}.service-card.cyan .service-icon{color:#5ce8ff}.service-card h3{font-size:11px;margin:0 0 5px}.service-card p{font-size:8px;color:#77737e;margin:0;line-height:1.7}

.section{margin-top:30px}.section-head,.market-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:14px}.section-head h2,.market-head h2{font-size:19px;margin:4px 0 0}.section-head a,.market-head a{font-size:10px;color:#c66cff}.section-kicker{font-size:9px;color:#77737f}.art-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}.art-card{border:1px solid rgba(255,255,255,.08);border-radius:12px;overflow:hidden;background:#0c0c12}.light .art-card{background:#fff;border-color:#e5e4eb}.art-image{height:205px;background-size:cover;background-position:center;position:relative}.art-image:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.65))}.art-stats{position:absolute;z-index:1;bottom:8px;right:8px;left:8px;display:flex;gap:10px;font-size:8px;color:#fff}.art-meta{padding:9px;display:flex;align-items:center;justify-content:space-between}.art-meta b,.art-meta small{display:block}.art-meta b{font-size:9px}.art-meta small{font-size:7px;color:#77737f;margin-top:3px}.mini-avatar{width:23px;height:23px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#7d4fff,#e64eff);font-size:8px}

.market{margin-top:32px;padding:20px;border:1px solid rgba(255,255,255,.07);background:rgba(13,13,20,.7);border-radius:18px}.light .market{background:#fff;border-color:#e5e4eb}.market-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:20px}.prompt-products{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.prompt-card{border:1px solid rgba(255,255,255,.08);border-radius:11px;overflow:hidden;background:rgba(255,255,255,.02)}.prompt-cover{height:130px;background-size:cover;background-position:center;position:relative}.prompt-cover:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.5))}.prompt-cover span{position:absolute;z-index:1;top:8px;right:8px;font-size:8px;padding:4px 7px;border-radius:99px;background:rgba(0,0,0,.5);color:#fff}.prompt-info{padding:8px}.prompt-info h3{font-size:9px;margin:0 0 9px}.prompt-bottom{display:flex;justify-content:space-between;font-size:8px}.prompt-bottom b{color:#df9aff}.prompt-bottom span{color:#f5c75b}.packages{border-right:1px solid rgba(255,255,255,.07);padding-right:20px}.package-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}.package-head span{font-size:12px;font-weight:800}.package-head small{font-size:8px;color:#77737f}.package-list{display:grid;grid-template-columns:repeat(4,1fr);gap:7px}.package{min-height:175px;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:12px 8px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;text-align:center;background:rgba(255,255,255,.02)}.package.featured{border-color:#b84cff;background:linear-gradient(180deg,rgba(183,73,255,.13),rgba(255,255,255,.02));box-shadow:0 0 25px rgba(174,64,255,.1)}.package small{font-size:8px;color:#88848f}.package strong{font-size:13px}.package>b{font-size:9px;color:#ddd}.package button{width:100%;border:1px solid rgba(255,255,255,.1);background:transparent;color:#bbb7c0;border-radius:7px;padding:6px 3px;font-size:8px}.package.featured button{background:linear-gradient(90deg,#b749ff,#6f76ff);border:0;color:#fff}

.stats{margin-top:28px;display:grid;grid-template-columns:repeat(4,1fr);padding:16px}.stats>div{display:flex;align-items:center;justify-content:center;gap:9px;border-left:1px solid rgba(255,255,255,.07)}.stats>div:last-child{border-left:0}.stats span{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:rgba(170,65,255,.11);color:#b96dff}.stats b{font-size:15px}.stats small{font-size:8px;color:#77737f}.trust{margin-top:12px;display:grid;grid-template-columns:repeat(6,1fr);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:16px;background:rgba(15,15,22,.65)}.light .trust{background:#fff;border-color:#e5e4eb}.trust>div{display:flex;flex-direction:column;align-items:center;text-align:center;gap:5px;border-left:1px solid rgba(255,255,255,.06)}.trust>div:last-child{border-left:0}.trust span{font-size:18px;color:#c76dff}.trust b{font-size:9px}.trust small{font-size:7px;color:#77737f}
.footer{padding:40px 0 25px;display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:center;color:#77737f;font-size:9px}.footer .brand{transform:scale(.82)}.footer>div{display:flex;gap:15px;justify-content:flex-end}.footer small{grid-column:1/-1;text-align:center;color:#55515b}

@media (max-width: 900px){.nav{display:none}.topbar{justify-content:space-between}.hero{grid-template-columns:1fr;min-height:auto;padding-top:35px}.hero-copy{text-align:center;padding:0}.hero-copy p{margin-inline:auto}.hero-actions{justify-content:center}.hero-stage{height:400px}.creator{grid-template-columns:1fr}.creator-options{border-right:0;border-top:1px solid rgba(255,255,255,.07);padding:16px 0 0}.services{grid-template-columns:repeat(3,1fr)}.art-grid{grid-template-columns:repeat(3,1fr)}.market-grid{grid-template-columns:1fr}.packages{border-right:0;border-top:1px solid rgba(255,255,255,.07);padding:18px 0 0}.stats{grid-template-columns:repeat(2,1fr);gap:10px}.stats>div{border:0}.trust{grid-template-columns:repeat(3,1fr);gap:16px}.trust>div{border:0}.footer{grid-template-columns:1fr;text-align:center}.footer>div{justify-content:center}.footer small{grid-column:auto}}
@media (max-width: 560px){.wrap{width:min(100% - 24px,1180px)}.topbar{height:62px;margin-top:10px;border-radius:17px}.brand{width:66px;height:48px;font-size:14px}.credits{display:none}.hero h1{font-size:40px;letter-spacing:-1px}.hero p{font-size:11px;line-height:2}.hero-stage{height:340px;transform:scale(.9)}.card-a{right:0}.card-b{left:0}.card-c{right:80px}.cube{width:130px;height:130px}.cube span{font-size:23px}.creator{padding:14px}.prompt-row{flex-direction:column}.prompt-submit{width:100%}.prompt-input{height:42px}.services{grid-template-columns:repeat(2,1fr)}.service-card{min-height:105px}.art-grid{grid-template-columns:repeat(2,1fr)}.art-image{height:180px}.prompt-products{grid-template-columns:repeat(2,1fr)}.package-list{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:1fr 1fr}.stats b{font-size:12px}.stats small{font-size:7px}.trust{grid-template-columns:repeat(2,1fr)}.footer p{line-height:2}}

/* ===== Tarhna Interactive 3D Cube ===== */

.interactive-cube-area {
  position: relative;
  width: min(42vw, 560px);
  height: min(42vw, 560px);
  min-width: 320px;
  min-height: 320px;
  display: grid;
  place-items: center;
  perspective: 1100px;
  cursor: grab;
  touch-action: pan-y;
  user-select: none;
  z-index: 5;
}

.interactive-cube-area:active {
  cursor: grabbing;
}

.interactive-cube {
  --cube-size: clamp(180px, 22vw, 330px);
  position: relative;
  width: var(--cube-size);
  height: var(--cube-size);
  transform-style: preserve-3d;
  transition: transform 80ms linear;
  z-index: 2;
}

.cube-face {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 1px solid rgba(129, 108, 255, 0.75);
  border-radius: 24px;
  background:
    radial-gradient(circle at 30% 20%, rgba(126,76,255,.30), transparent 45%),
    linear-gradient(145deg, rgba(19,20,45,.97), rgba(5,7,20,.98));
  box-shadow:
    inset 0 0 40px rgba(77, 102, 255, .15),
    0 0 25px rgba(120, 65, 255, .35);
  backface-visibility: hidden;
}

.cube-face span {
  font-size: clamp(28px, 4vw, 58px);
  font-weight: 900;
  color: #fff;
  text-shadow:
    0 0 15px rgba(255,255,255,.45),
    0 0 32px rgba(121,75,255,.8);
  pointer-events: none;
}

.cube-front {
  transform: translateZ(calc(var(--cube-size) / 2));
}

.cube-back {
  transform: rotateY(180deg) translateZ(calc(var(--cube-size) / 2));
}

.cube-right {
  transform: rotateY(90deg) translateZ(calc(var(--cube-size) / 2));
}

.cube-left {
  transform: rotateY(-90deg) translateZ(calc(var(--cube-size) / 2));
}

.cube-top {
  transform: rotateX(90deg) translateZ(calc(var(--cube-size) / 2));
}

.cube-bottom {
  transform: rotateX(-90deg) translateZ(calc(var(--cube-size) / 2));
}

.cube-drag-label {
  position: absolute;
  top: 4%;
  padding: 9px 16px;
  border: 1px solid rgba(194, 118, 255, .4);
  border-radius: 999px;
  background: rgba(8, 7, 25, .68);
  backdrop-filter: blur(12px);
  color: #eee;
  font-size: 12px;
  z-index: 10;
  pointer-events: none;
}

.cube-floor-glow {
  position: absolute;
  width: 65%;
  height: 15%;
  bottom: 11%;
  border-radius: 50%;
  background: rgba(112, 64, 255, .42);
  filter: blur(30px);
  transform: rotateX(70deg);
  pointer-events: none;
}

@media (max-width: 768px) {
  .interactive-cube-area {
    width: 100%;
    height: 390px;
    min-width: 0;
    min-height: 0;
  }

  .interactive-cube {
    --cube-size: 210px;
  }

  .cube-face {
    border-radius: 18px;
  }
}

/* ===== Tarhna Fullscreen Interactive Hero ===== */

.hero {
  min-height: calc(100svh - 105px);
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  align-items: center;
  gap: clamp(25px, 4vw, 70px);
  padding-top: 35px;
  padding-bottom: 55px;
}

.hero-stage {
  width: 100%;
  min-width: 0;
  min-height: 570px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.interactive-cube-area {
  position: relative;
  width: 100%;
  height: 570px;
  min-width: 0;
  perspective: 1200px;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
  cursor: grab;
  user-select: none;
}

.interactive-cube-area:active {
  cursor: grabbing;
}

.interactive-cube {
  --cube-size: clamp(260px, 25vw, 390px);
  width: var(--cube-size);
  height: var(--cube-size);
  position: relative;
  transform-style: preserve-3d;
  transition: transform 70ms linear;
  z-index: 4;
}

.cube-face {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10px;

  border: 1px solid rgba(173, 115, 255, 0.55);
  border-radius: 32px;

  background:
    radial-gradient(circle at 30% 20%,
      rgba(129, 72, 255, 0.28),
      transparent 42%),
    linear-gradient(
      145deg,
      rgba(35, 25, 67, 0.96),
      rgba(9, 8, 18, 0.98)
    );

  box-shadow:
    inset 0 0 45px rgba(147, 71, 255, 0.22),
    0 0 35px rgba(126, 58, 237, 0.18);

  backface-visibility: hidden;
}

.cube-face > span {
  font-size: clamp(28px, 3vw, 46px);
  font-weight: 900;
  text-shadow: 0 0 22px rgba(201, 166, 255, 0.35);
}

.cube-face small {
  font-size: 10px;
  letter-spacing: 4px;
  opacity: 0.45;
}

.cube-front {
  transform: translateZ(calc(var(--cube-size) / 2));
}

.cube-back {
  transform: rotateY(180deg)
    translateZ(calc(var(--cube-size) / 2));
}

.cube-right {
  transform: rotateY(90deg)
    translateZ(calc(var(--cube-size) / 2));
}

.cube-left {
  transform: rotateY(-90deg)
    translateZ(calc(var(--cube-size) / 2));
}

.cube-top {
  transform: rotateX(90deg)
    translateZ(calc(var(--cube-size) / 2));
}

.cube-bottom {
  transform: rotateX(-90deg)
    translateZ(calc(var(--cube-size) / 2));
}

.cube-floor-glow {
  position: absolute;
  width: min(72%, 500px);
  height: 80px;
  bottom: 35px;
  border-radius: 50%;
  border: 2px solid rgba(174, 85, 255, 0.8);
  background: rgba(111, 40, 255, 0.08);
  box-shadow:
    0 0 20px rgba(163, 73, 255, 0.75),
    0 0 70px rgba(113, 46, 255, 0.45),
    inset 0 0 35px rgba(181, 87, 255, 0.25);
  transform: rotateX(68deg);
  filter: blur(0.2px);
}

.cube-drag-label {
  position: absolute;
  bottom: 2px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 8px 14px;
  border-radius: 999px;
  border: 1px solid rgba(175, 115, 255, 0.22);
  background: rgba(15, 10, 27, 0.7);
  backdrop-filter: blur(12px);

  font-size: 11px;
  opacity: 0.7;
  white-space: nowrap;
  pointer-events: none;
}

/* Mobile */
@media (max-width: 768px) {
  .hero {
    min-height: auto;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-top: 35px;
    padding-bottom: 40px;
  }

  .hero-stage {
    min-height: 430px;
    width: 100%;
  }

  .interactive-cube-area {
    width: 100%;
    height: 430px;
    min-width: 0;
    perspective: 900px;
  }

  .interactive-cube {
    --cube-size: min(55vw, 230px);
  }

  .cube-face {
    border-radius: 22px;
  }

  .cube-face > span {
    font-size: 27px;
  }

  .cube-floor-glow {
    width: 72%;
    height: 60px;
    bottom: 38px;
  }
}

/* Tarhna neon logo on 3D cube */
.cube-front {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cube-logo {
  width: 88%;
  height: auto;
  object-fit: contain;
  user-select: none;
  pointer-events: none;
  filter:
    drop-shadow(0 0 8px rgba(111, 67, 255, .8))
    drop-shadow(0 0 18px rgba(0, 174, 255, .45))
    drop-shadow(0 0 25px rgba(220, 30, 255, .35));
}

/* ===== Tarhna Header Brand ===== */

.tarhna-brand {
  width: 92px;
  height: 62px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  flex-shrink: 0;
}

.tarhna-brand-logo {
  width: 82px;
  height: 40px;
  object-fit: contain;
  display: block;
  filter:
    drop-shadow(0 0 5px rgba(168, 85, 247, .75))
    drop-shadow(0 0 9px rgba(14, 165, 233, .45));
}

.tarhna-brand-en {
  direction: ltr;
  font-family: Arial, sans-serif;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  line-height: 1;
  background: linear-gradient(90deg, #22d3ee, #7c3aed, #ec4899);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-transform: none;
  white-space: nowrap;
}

@media (max-width: 768px) {
  .tarhna-brand {
    width: 72px;
    height: 52px;
  }

  .tarhna-brand-logo {
    width: 68px;
    height: 32px;
  }

  .tarhna-brand-en {
    font-size: 8px;
    letter-spacing: 2px;
  }
}

/* ===== Tarhna header logo final ===== */

.tarhna-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 105px;
  height: 72px;
  padding: 0;
  margin: 0;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  overflow: visible;
}

.tarhna-brand-logo {
  display: block;
  width: 100px !important;
  height: auto !important;
  max-width: none !important;
  object-fit: contain;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
}

/* لوگو در تم روشن */
.site.light .tarhna-brand,
.site.light .tarhna-brand-logo {
  background: transparent !important;
}

/* لوگو در تم تاریک */
.site.dark .tarhna-brand,
.site.dark .tarhna-brand-logo {
  background: transparent !important;
}

@media (max-width: 700px) {
  .tarhna-brand {
    width: 92px;
    height: 62px;
  }

  .tarhna-brand-logo {
    width: 88px !important;
  }
}

