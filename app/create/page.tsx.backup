"use client";

import { useMemo, useState } from "react";

type RatioOption = {
  id: string;
  title: string;
  ratio: string;
  width: number;
  height: number;
  group: "square" | "portrait" | "landscape";
};

const ratioOptions: RatioOption[] = [
  { id: "1-1", title: "مربع", ratio: "1:1", width: 1, height: 1, group: "square" },

  { id: "4-5", title: "پست اینستاگرام", ratio: "4:5", width: 4, height: 5, group: "portrait" },
  { id: "3-4", title: "عمودی", ratio: "3:4", width: 3, height: 4, group: "portrait" },
  { id: "2-3", title: "پرتره", ratio: "2:3", width: 2, height: 3, group: "portrait" },
  { id: "9-16", title: "استوری و ریلز", ratio: "9:16", width: 9, height: 16, group: "portrait" },

  { id: "5-4", title: "افقی کوتاه", ratio: "5:4", width: 5, height: 4, group: "landscape" },
  { id: "4-3", title: "افقی کلاسیک", ratio: "4:3", width: 4, height: 3, group: "landscape" },
  { id: "3-2", title: "عکاسی", ratio: "3:2", width: 3, height: 2, group: "landscape" },
  { id: "16-9", title: "یوتیوب", ratio: "16:9", width: 16, height: 9, group: "landscape" },
  { id: "21-9", title: "سینمایی", ratio: "21:9", width: 21, height: 9, group: "landscape" },
];

export default function CreatePage() {
  const [prompt, setPrompt] = useState("");
  const [quality, setQuality] = useState<"normal" | "pro">("normal");
  const [selectedRatio, setSelectedRatio] = useState("1-1");
  const [customMode, setCustomMode] = useState(false);
  const [customWidth, setCustomWidth] = useState(1024);
  const [customHeight, setCustomHeight] = useState(1024);
  const [count, setCount] = useState(1);
  const [generating, setGenerating] = useState(false);

  const activeRatio = useMemo(
    () => ratioOptions.find((item) => item.id === selectedRatio) ?? ratioOptions[0],
    [selectedRatio]
  );

  const pricePerImage = quality === "normal" ? 2500 : 5000;
  const totalPrice = pricePerImage * count;

  const previewRatio = customMode
    ? String(customWidth) + " / " + String(customHeight)
    : String(activeRatio.width) + " / " + String(activeRatio.height);

  function chooseRatio(id: string) {
    setSelectedRatio(id);
    setCustomMode(false);
  }

  function generateImage() {
    if (!prompt.trim()) return;

    setGenerating(true);

    setTimeout(() => {
      setGenerating(false);
    }, 1800);
  }

  return (
    <main className="create-page" dir="rtl">
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="topbar">
        <a href="/" className="brand" aria-label="طرحنا">
          <img src="/images/tarhna-logo.png" alt="طرحنا" />
        </a>

        <div className="top-actions">
          <div className="credit-pill">
            <span className="credit-star">✦</span>
            <div>
              <small>اعتبار شما</small>
              <b>۵۰ اعتبار</b>
            </div>
          </div>

          <a href="/dashboard" className="account-link">
            حساب کاربری
          </a>
        </div>
      </header>

      <section className="intro">
        <div className="eyebrow">
          <span>✦</span>
          استودیوی هوش مصنوعی طرحنا
        </div>

        <h1>
          ایده‌ات را به
          <span> تصویر تبدیل کن</span>
        </h1>

        <p>
          هر چیزی که در ذهن داری توصیف کن؛ طرحنا آن را به یک تصویر
          حرفه‌ای تبدیل می‌کند.
        </p>
      </section>

      <section className="workspace">
        <div className="control-panel">
          <div className="section-title">
            <span className="step">01</span>
            <div>
              <h2>ایده‌ات را بنویس</h2>
              <p>هرچقدر دقیق‌تر توضیح بدهی، نتیجه بهتر می‌شود.</p>
            </div>
          </div>

          <div className="prompt-box">
            <span className="prompt-label">AI PROMPT</span>

            <textarea
              value={prompt}
              maxLength={1200}
              onChange={(e) => setPrompt(e.target.value)}
              placeholder="مثلاً: یک شهر آینده‌نگر ایرانی در شب، معماری مدرن، نورهای نئونی بنفش و آبی، نمای سینمایی..."
            />

            <div className="prompt-footer">
              <button type="button" className="enhance-btn">
                ✦ بهبود پرامپت
              </button>

              <span>{prompt.length} / 1200</span>
            </div>
          </div>

          <div className="divider" />

          <div className="section-title">
            <span className="step">02</span>
            <div>
              <h2>کیفیت تصویر</h2>
              <p>مدل مناسب برای خروجی خودت را انتخاب کن.</p>
            </div>
          </div>

          <div className="quality-grid">
            <button
              type="button"
              className={"quality-card " + (quality === "normal"  ? "active" : ""))}
              onClick={() => setQuality("normal")}
            >
              <span className="quality-icon">✦</span>
              <div>
                <b>معمولی</b>
                <small>سریع و اقتصادی</small>
              </div>
              <strong>۲,۵۰۰ تومان</strong>
            </button>

            <button
              type="button"
              className={"quality-card " + (quality === "pro"  ? "active" : ""))}
              onClick={() => setQuality("pro")}
            >
              <span className="quality-icon">◆</span>
              <div>
                <b>حرفه‌ای</b>
                <small>جزئیات و کیفیت بیشتر</small>
              </div>
              <strong>۵,۰۰۰ تومان</strong>
            </button>
          </div>

          <div className="divider" />

          <div className="section-title ratio-title">
            <span className="step">03</span>
            <div>
              <h2>نسبت و اندازه تصویر</h2>
              <p>ابعاد مناسب خروجی را انتخاب کن.</p>
            </div>
          </div>
          <div className="ratio-section">
            <div className="ratio-group">
              <div className="group-label">
                <span>▣</span>
                <b>مربع</b>
              </div>

              <div className="ratio-grid square-grid">
                {ratioOptions
                  .filter((item) => item.group === "square")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                  className={"ratio-card " + (!customMode && selectedRatio === item.id  ? "active" : ""))}
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                      aspectRatio: String(item.width) + "/" + String(item.height),
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <div className="ratio-group">
              <div className="group-label">
                <span>▯</span>
                <b>عمودی</b>
              </div>

              <div className="ratio-grid">
                {ratioOptions
                  .filter((item) => item.group === "portrait")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                      className={"ratio-card " + (
                        !customMode && selectedRatio === item.id  ? "active" : "")
                      }}
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                            aspectRatio: `${item.width}/${item.height},
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <div className="ratio-group">
              <div className="group-label">
                <span>▭</span>
                <b>افقی</b>
              </div>

              <div className="ratio-grid">
                {ratioOptions
                  .filter((item) => item.group === "landscape")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                      className={"ratio-card " + (
                        !customMode && selectedRatio === item.id  ? "active" : "")
                      }}
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                            aspectRatio: `${item.width}/${item.height},
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <button
              type="button"
              className={`custom-size-card ${customMode  ? "active" : "")}}
              onClick={() => setCustomMode(true)}
            >
              <div className="custom-icon">⌗</div>

              <div className="custom-copy">
                <b>اندازه دلخواه</b>
                <small>عرض و ارتفاع تصویر را خودت مشخص کن</small>
              </div>

              <span className="custom-arrow">←</span>
            </button>

            {customMode && (
              <div className="custom-panel">
                <div className="custom-panel-head">
                  <div>
                    <b>ابعاد اختصاصی</b>
                    <small>اندازه خروجی را به پیکسل وارد کن</small>
                  </div>

                  <span>Custom Size</span>
                </div>

                <div className="custom-inputs">
                  <label>
                    <span>عرض</span>
                    <div>
                      <input
                        type="number"
                        min="256"
                        max="4096"
                        value={customWidth}
                        onChange={(e) =>
                          setCustomWidth(
                            Math.max(256, Number(e.target.value) || 256)
                          )
                        }
                      />
                      <small>px</small>
                    </div>
                  </label>

                  <span className="size-x">×</span>

                  <label>
                    <span>ارتفاع</span>
                    <div>
                      <input
                        type="number"
                        min="256"
                        max="4096"
                        value={customHeight}
                        onChange={(e) =>
                          setCustomHeight(
                            Math.max(256, Number(e.target.value) || 256)
                          )
                        }
                      />
                      <small>px</small>
                    </div>
                  </label>
                </div>

                <div className="custom-presets">
                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1080);
                      setCustomHeight(1920);
                    }}
                  >
                    استوری 1080×1920
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1920);
                      setCustomHeight(1080);
                    }}
                  >
                    Full HD 1920×1080
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1080);
                      setCustomHeight(1350);
                    }}
                  >
                    پست 1080×1350
                  </button>
                </div>
              </div>
            )}
          </div>

          <div className="divider" />

          <div className="section-title">
            <span className="step">04</span>
            <div>
              <h2>تعداد تصاویر</h2>
              <p>چند خروجی متفاوت می‌خواهی؟</p>
            </div>
          </div>

          <div className="count-price-row">
            <div className="count-selector">
              <button
                type="button"
                onClick={() => setCount((value) => Math.max(1, value - 1))}
                disabled={count <= 1}
              >
                −
              </button>

              <div>
                <b>{count}</b>
                <small>تصویر</small>
              </div>

              <button
                type="button"
                onClick={() => setCount((value) => Math.min(4, value + 1))}
                disabled={count >= 4}
              >
                +
              </button>
            </div>

            <div className="price-box">
              <small>هزینه تولید</small>
              <b>{totalPrice.toLocaleString("fa-IR")} تومان</b>
              <span>
                {quality === "normal" ? "کیفیت معمولی" : "کیفیت حرفه‌ای"} ×{" "}
                {count}
              </span>
            </div>
          </div>

          <button
            type="button"
            className="generate-btn"
            onClick={generateImage}
            disabled={generating || !prompt.trim()}
          >
            <span className="generate-icon">✦</span>

            <span>
              <b>{generating ? "در حال ساخت تصویر..." : "تولید تصویر"}</b>
              <small>
                {prompt.trim()
                  ? `${count} خروجی • ${totalPrice.toLocaleString(
                      "fa-IR"
                    )} تومان`
                  : "برای شروع، ایده‌ات را بنویس"}
              </small>
            </span>

            <span className="generate-arrow">←</span>
          </button>
        </div>

        <aside className="preview-panel">
          <div className="preview-head">
            <div>
              <span className="live-dot" />
              <b>پیش‌نمایش خروجی</b>
            </div>

            <span className="preview-ratio">
              {customMode
                ? `${customWidth}×${customHeight}
                : activeRatio.ratio}
            </span>
          </div>

          <div className="preview-stage">
            <div className="preview-glow" />

            <div
              className="preview-canvas"
              style={{
                aspectRatio: previewRatio,
              }}
            >
              {generating ? (
                <div className="loading-state">
                  <div className="loader" />
                  <h3>در حال خلق تصویر...</h3>
                  <p>هوش مصنوعی طرحنا در حال پردازش ایده توست.</p>
                </div>
              ) : (
                <div className="empty-state">
                  <div className="magic-icon">✦</div>
                  <h3>تصویر تو اینجا ساخته می‌شود</h3>
                  <p>
                    پرامپت، کیفیت و ابعاد را انتخاب کن و دکمه تولید را بزن.
                  </p>
                </div>
              )}
            </div>
          </div>

          <div className="preview-details">
            <div>
              <small>مدل</small>
              <b>
                {quality === "normal" ? "Tarhna Standard" : "Tarhna Pro"}
              </b>
            </div>

            <div>
              <small>تعداد</small>
              <b>{count} تصویر</b>
            </div>

            <div>
              <small>ابعاد</small>
              <b>
                {customMode
                  ? `${customWidth} × ${customHeight}
                  : activeRatio.ratio}
              </b>
            </div>
          </div>

          <div className="tip">
            <span>💡</span>
            <p>
              برای نتیجه بهتر، درباره نور، سبک، زاویه دوربین و جزئیات صحنه
              توضیح بده.
            </p>
          </div>
        </aside>
      </section>

        * {
          box-sizing: border-box;
        }

        .create-page {
          --bg: #030617;
          --panel: rgba(8, 10, 34, 0.82);
          --panel-2: rgba(15, 12, 48, 0.68);
          --border: rgba(168, 85, 247, 0.16);
          --border-soft: rgba(255, 255, 255, 0.07);
          --text: #f8f5ff;
          --muted: #77748e;
          --purple: #a855f7;
          --purple-2: #7c3aed;
          --pink: #d946ef;

          min-height: 100vh;
          position: relative;
          overflow: hidden;
          background:
            radial-gradient(
              circle at 78% 5%,
              rgba(88, 28, 135, 0.2),
              transparent 29%
            ),
            radial-gradient(
              circle at 10% 60%,
              rgba(30, 64, 175, 0.08),
              transparent 28%
            ),
            var(--bg);
          color: var(--text);
          font-family: Arial, sans-serif;
          padding-bottom: 80px;
        }

        .ambient {
          position: absolute;
          border-radius: 999px;
          filter: blur(100px);
          pointer-events: none;
        }

        .ambient-one {
          width: 360px;
          height: 360px;
          top: -160px;
          right: 10%;
          background: rgba(124, 58, 237, 0.12);
        }

        .ambient-two {
          width: 300px;
          height: 300px;
          top: 700px;
          left: -170px;
          background: rgba(59, 130, 246, 0.06);
        }

        .topbar {
          width: min(1180px, calc(100% - 40px));
          height: 96px;
          margin: 0 auto;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid rgba(255, 255, 255, 0.035);
          position: relative;
          z-index: 5;
        }

        .brand {
          display: flex;
          align-items: center;
          justify-content: center;
          text-decoration: none;
          background: transparent;
          border: 0;
          padding: 0;
        }

        .brand img {
          width: 116px;
          height: auto;
          display: block;
          object-fit: contain;
          background: transparent;
          border: 0;
          border-radius: 0;
          box-shadow: none;
        }

        .top-actions {
          display: flex;
          align-items: center;
          gap: 22px;
        }

        .account-link {
          color: #e7e2f3;
          text-decoration: none;
          font-size: 14px;
        }

        .credit-pill {
          min-width: 130px;
          min-height: 57px;
          border: 1px solid rgba(168, 85, 247, 0.24);
          border-radius: 17px;
          padding: 9px 13px;
          display: flex;
          align-items: center;
          gap: 10px;
          background: linear-gradient(
            135deg,
            rgba(124, 58, 237, 0.15),
            rgba(88, 28, 135, 0.05)
          );
        }

        .credit-star {
          width: 31px;
          height: 31px;
          border-radius: 10px;
          display: grid;
          place-items: center;
          color: #d8b4fe;
          background: rgba(168, 85, 247, 0.12);
        }

        .credit-pill div {
          display: flex;
          flex-direction: column;
          gap: 3px;
        }

        .credit-pill small {
          color: #7e7991;
          font-size: 9px;
        }

        .credit-pill b {
          font-size: 11px;
          font-weight: 600;
        }

        .intro {
          width: min(900px, calc(100% - 40px));
          margin: 68px auto 43px;
          text-align: center;
          position: relative;
          z-index: 2;
        }

        .eyebrow {
          width: fit-content;
          margin: 0 auto 24px;
          border: 1px solid rgba(168, 85, 247, 0.2);
          border-radius: 999px;
          background: rgba(124, 58, 237, 0.07);
          padding: 10px 17px;
          color: #9b92af;
          font-size: 11px;
        }

        .eyebrow span {
          color: #c084fc;
          margin-left: 6px;
        }

        .intro h1 {
          margin: 0;
          font-size: clamp(38px, 5vw, 62px);
          line-height: 1.35;
          letter-spacing: -1px;
        }

        .intro h1 span {
          background: linear-gradient(90deg, #d946ef, #8b5cf6, #60a5fa);
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
        }

        .intro p {
          margin: 20px auto 0;
          max-width: 660px;
          color: #77748c;
          font-size: 13px;
          line-height: 2;
        }

        .workspace {
          width: min(1180px, calc(100% - 40px));
          margin: 0 auto;
          display: grid;
          grid-template-columns: minmax(0, 1.2fr) minmax(330px, 0.8fr);
          gap: 22px;
          align-items: start;
          position: relative;
          z-index: 2;
        }
        .control-panel,
        .preview-panel {
          border: 1px solid var(--border-soft);
          border-radius: 28px;
          background:
            linear-gradient(
              145deg,
              rgba(13, 14, 42, 0.9),
              rgba(5, 7, 27, 0.88)
            );
          box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.025);
          backdrop-filter: blur(18px);
        }

        .control-panel {
          padding: 30px;
        }

        .section-title {
          display: flex;
          align-items: center;
          gap: 15px;
          margin-bottom: 20px;
        }

        .step {
          width: 45px;
          height: 45px;
          flex: 0 0 45px;
          border-radius: 14px;
          display: grid;
          place-items: center;
          border: 1px solid rgba(168, 85, 247, 0.18);
          background: rgba(124, 58, 237, 0.08);
          color: #b88cff;
          font-size: 10px;
        }

        .section-title h2 {
          margin: 0 0 6px;
          font-size: 17px;
          font-weight: 600;
        }

        .section-title p {
          margin: 0;
          color: var(--muted);
          font-size: 10px;
        }

        .prompt-box {
          position: relative;
          min-height: 200px;
          border: 1px solid rgba(168, 85, 247, 0.12);
          border-radius: 22px;
          background: rgba(2, 4, 20, 0.6);
          overflow: hidden;
        }

        .prompt-box:focus-within {
          border-color: rgba(168, 85, 247, 0.38);
          box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.04);
        }

        .prompt-box textarea {
          width: 100%;
          min-height: 200px;
          resize: vertical;
          border: 0;
          outline: 0;
          background: transparent;
          color: #f4efff;
          padding: 22px 22px 55px;
          font-family: inherit;
          font-size: 13px;
          line-height: 2;
        }

        .prompt-box textarea::placeholder {
          color: #4f4d63;
        }

        .prompt-bottom {
          position: absolute;
          right: 17px;
          left: 17px;
          bottom: 14px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          pointer-events: none;
        }

        .prompt-bottom span {
          color: #555268;
          font-size: 9px;
        }

        .enhance-btn {
          pointer-events: auto;
          border: 1px solid rgba(168, 85, 247, 0.16);
          border-radius: 10px;
          background: rgba(124, 58, 237, 0.07);
          color: #9d7ac8;
          min-height: 34px;
          padding: 0 12px;
          font-family: inherit;
          font-size: 9px;
          cursor: pointer;
        }

        .enhance-btn:disabled {
          opacity: 0.4;
          cursor: not-allowed;
        }

        .divider {
          height: 1px;
          background: rgba(255, 255, 255, 0.045);
          margin: 30px 0;
        }

        .quality-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 13px;
        }

        .quality-card {
          position: relative;
          min-height: 108px;
          border: 1px solid var(--border-soft);
          border-radius: 19px;
          background: rgba(255, 255, 255, 0.018);
          color: #fff;
          padding: 16px;
          display: grid;
          grid-template-columns: 42px 1fr;
          align-items: center;
          gap: 12px;
          text-align: right;
          cursor: pointer;
          font-family: inherit;
          transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
        }

        .quality-card:hover {
          transform: translateY(-2px);
          border-color: rgba(168, 85, 247, 0.25);
        }

        .quality-card.active {
          border-color: rgba(168, 85, 247, 0.55);
          background:
            linear-gradient(
              135deg,
              rgba(124, 58, 237, 0.17),
              rgba(79, 70, 229, 0.045)
            );
          box-shadow:
            inset 0 0 35px rgba(124, 58, 237, 0.055),
            0 8px 30px rgba(76, 29, 149, 0.06);
        }

        .quality-icon {
          width: 42px;
          height: 42px;
          border-radius: 12px;
          display: grid;
          place-items: center;
          background: rgba(124, 58, 237, 0.12);
          color: #c084fc;
          font-size: 18px;
        }

        .quality-card > div:nth-child(2) {
          display: flex;
          flex-direction: column;
          gap: 5px;
        }

        .quality-card b {
          font-size: 12px;
        }

        .quality-card span {
          color: #77748c;
          font-size: 9px;
        }

        .quality-card strong {
          grid-column: 2;
          color: #c69aff;
          font-size: 10px;
          font-weight: 500;
        }

        .selected-check {
          position: absolute;
          top: 10px;
          left: 10px;
          width: 20px;
          height: 20px;
          border-radius: 50%;
          display: grid;
          place-items: center;
          background: #8b5cf6;
          color: #fff;
          font-size: 10px;
          box-shadow: 0 0 18px rgba(139, 92, 246, 0.45);
        }

        .ratio-section {
          display: flex;
          flex-direction: column;
          gap: 25px;
        }

        .ratio-group {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }

        .group-label {
          display: flex;
          align-items: center;
          gap: 8px;
          color: #8f8aa4;
          font-size: 10px;
        }

        .group-label span {
          color: #a855f7;
          font-size: 14px;
        }

        .ratio-grid {
          display: grid;
          grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: 10px;
        }

        .square-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ratio-card {
          min-height: 120px;
          position: relative;
          border: 1px solid rgba(255, 255, 255, 0.06);
          border-radius: 17px;
          background: rgba(255, 255, 255, 0.016);
          color: #fff;
          padding: 13px 9px 11px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 10px;
          cursor: pointer;
          font-family: inherit;
          transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            background 0.2s ease;
        }

        .ratio-card:hover {
          transform: translateY(-2px);
          border-color: rgba(168, 85, 247, 0.25);
        }

        .ratio-card.active {
          border-color: rgba(168, 85, 247, 0.55);
          background:
            radial-gradient(
              circle at 50% 20%,
              rgba(168, 85, 247, 0.15),
              transparent 55%
            ),
            rgba(124, 58, 237, 0.07);
        }

        .ratio-shape-wrap {
          height: 48px;
          width: 58px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .ratio-shape {
          display: block;
          max-width: 54px;
          max-height: 46px;
          width: auto;
          height: 42px;
          border: 1.5px solid #9f67eb;
          border-radius: 4px;
          background:
            linear-gradient(
              145deg,
              rgba(168, 85, 247, 0.12),
              rgba(59, 130, 246, 0.03)
            );
          box-shadow:
            0 0 13px rgba(168, 85, 247, 0.12),
            inset 0 0 12px rgba(168, 85, 247, 0.06);
        }

        .ratio-text {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 4px;
        }

        .ratio-text b {
          font-size: 11px;
          direction: ltr;
        }

        .ratio-text small {
          color: #666277;
          font-size: 8px;
        }

        .custom-size-card {
          width: 100%;
          min-height: 84px;
          border: 1px dashed rgba(168, 85, 247, 0.22);
          border-radius: 19px;
          background:
            linear-gradient(
              100deg,
              rgba(124, 58, 237, 0.055),
              rgba(255, 255, 255, 0.01)
            );
          color: #fff;
          padding: 15px 17px;
          display: grid;
          grid-template-columns: 44px 1fr auto;
          align-items: center;
          gap: 13px;
          text-align: right;
          font-family: inherit;
          cursor: pointer;
          transition: 0.2s ease;
        }

        .custom-size-card:hover,
        .custom-size-card.active {
          border-color: rgba(168, 85, 247, 0.5);
          background:
            linear-gradient(
              100deg,
              rgba(124, 58, 237, 0.14),
              rgba(79, 70, 229, 0.025)
            );
        }

        .custom-icon {
          width: 44px;
          height: 44px;
          border-radius: 13px;
          display: grid;
          place-items: center;
          background: rgba(168, 85, 247, 0.11);
          color: #c084fc;
          font-size: 20px;
        }

        .custom-copy {
          display: flex;
          flex-direction: column;
          gap: 6px;
        }

        .custom-copy b {
          font-size: 12px;
        }

        .custom-copy small {
          color: #706b82;
          font-size: 9px;
        }

        .custom-arrow {
          color: #8b5cf6;
          font-size: 18px;
        }

        .custom-panel {
          border: 1px solid rgba(168, 85, 247, 0.16);
          border-radius: 20px;
          padding: 18px;
          background:
            radial-gradient(
              circle at 80% 0%,
              rgba(124, 58, 237, 0.1),
              transparent 45%
            ),
            rgba(2, 4, 20, 0.55);
        }

        .custom-panel-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 15px;
          margin-bottom: 18px;
        }

        .custom-panel-head > div {
          display: flex;
          flex-direction: column;
          gap: 5px;
        }

        .custom-panel-head b {
          font-size: 12px;
        }

        .custom-panel-head small {
          color: #716d80;
          font-size: 8px;
        }

        .custom-panel-head > span {
          direction: ltr;
          color: #9c71d2;
          font-size: 8px;
          border: 1px solid rgba(168, 85, 247, 0.15);
          border-radius: 999px;
          padding: 6px 9px;
        }

        .custom-inputs {
          display: grid;
          grid-template-columns: 1fr auto 1fr;
          align-items: end;
          gap: 10px;
        }

        .custom-inputs label {
          display: flex;
          flex-direction: column;
          gap: 7px;
          color: #898398;
          font-size: 9px;
        }

        .custom-inputs label > div {
          height: 48px;
          display: flex;
          align-items: center;
          border: 1px solid rgba(255, 255, 255, 0.07);
          border-radius: 13px;
          background: rgba(255, 255, 255, 0.018);
          overflow: hidden;
        }

        .custom-inputs input {
          min-width: 0;
          width: 100%;
          height: 100%;
          border: 0;
          outline: 0;
          background: transparent;
          color: #fff;
          padding: 0 13px;
          font-family: inherit;
          direction: ltr;
        }

        .custom-inputs label small {
          padding: 0 10px;
          color: #645e72;
          direction: ltr;
        }

        .size-x {
          color: #6e687c;
          padding-bottom: 14px;
        }

        .custom-presets {
          margin-top: 12px;
          display: flex;
          gap: 7px;
          flex-wrap: wrap;
        }

        .custom-presets button {
          border: 1px solid rgba(255, 255, 255, 0.055);
          border-radius: 9px;
          background: rgba(255, 255, 255, 0.018);
          color: #807a90;
          min-height: 31px;
          padding: 0 10px;
          font-family: inherit;
          font-size: 8px;
          cursor: pointer;
        }

        .custom-presets button:hover {
          color: #c084fc;
          border-color: rgba(168, 85, 247, 0.25);
        }

        .count-price-row {
          display: grid;
          grid-template-columns: 190px 1fr;
          gap: 14px;
        }

        .count-selector,
        .price-box {
          min-height: 82px;
          border: 1px solid rgba(255, 255, 255, 0.055);
          border-radius: 17px;
          background: rgba(255, 255, 255, 0.015);
        }

        .count-selector {
          padding: 11px;
          display: grid;
          grid-template-columns: 38px 1fr 38px;
          align-items: center;
          gap: 8px;
        }

        .count-selector button {
          width: 38px;
          height: 38px;
          border: 1px solid rgba(168, 85, 247, 0.15);
          border-radius: 11px;
          background: rgba(124, 58, 237, 0.07);
          color: #c084fc;
          font-size: 20px;
          cursor: pointer;
        }

        .count-selector button:disabled {
          opacity: 0.25;
          cursor: not-allowed;
        }

        .count-selector div {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 3px;
        }

        .count-selector b {
          font-size: 19px;
        }

        .count-selector small {
          color: #656073;
          font-size: 8px;
        }

        .price-box {
          padding: 14px 17px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          gap: 5px;
        }

        .price-box small {
          color: #6f697e;
          font-size: 8px;
        }

        .price-box b {
          color: #d8b4fe;
          font-size: 13px;
        }

        .price-box span {
          color: #555063;
          font-size: 8px;
        }

        .generate-btn {
          width: 100%;
          min-height: 70px;
          margin-top: 22px;
          border: 1px solid rgba(192, 132, 252, 0.35);
          border-radius: 18px;
          padding: 10px 17px;
          display: grid;
          grid-template-columns: 43px 1fr auto;
          align-items: center;
          gap: 13px;
          text-align: right;
          font-family: inherit;
          color: #fff;
          cursor: pointer;
          background:
            linear-gradient(
              110deg,
              #6d28d9,
              #7c3aed 45%,
              #9333ea
            );
          box-shadow:
            0 13px 35px rgba(109, 40, 217, 0.22),
            inset 0 1px 0 rgba(255, 255, 255, 0.16);
          transition: 0.2s ease;
        }

        .generate-btn:hover:not(:disabled) {
          transform: translateY(-2px);
          box-shadow:
            0 17px 45px rgba(109, 40, 217, 0.3),
            inset 0 1px 0 rgba(255, 255, 255, 0.18);
        }

        .generate-btn:disabled {
          opacity: 0.38;
          cursor: not-allowed;
          filter: grayscale(0.3);
        }

        .generate-icon {
          width: 43px;
          height: 43px;
          border-radius: 13px;
          display: grid;
          place-items: center;
          background: rgba(255, 255, 255, 0.12);
          font-size: 18px;
        }

        .generate-btn > span:nth-child(2) {
          display: flex;
          flex-direction: column;
          gap: 5px;
        }

        .generate-btn b {
          font-size: 13px;
        }

        .generate-btn small {
          color: rgba(255, 255, 255, 0.62);
          font-size: 8px;
        }

        .generate-arrow {
          font-size: 19px;
        }

        .preview-panel {
          padding: 20px;
          position: sticky;
          top: 20px;
        }

        .preview-head {
          min-height: 43px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 10px;
          margin-bottom: 15px;
        }

        .preview-head > div {
          display: flex;
          align-items: center;
          gap: 8px;
        }

        .preview-head b {
          font-size: 11px;
          font-weight: 500;
        }

        .live-dot {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          background: #a855f7;
          box-shadow: 0 0 12px #a855f7;
        }

        .preview-ratio {
          direction: ltr;
          border: 1px solid rgba(168, 85, 247, 0.14);
          border-radius: 999px;
          padding: 6px 9px;
          color: #8f6bbd;
          font-size: 8px;
        }

        .preview-stage {
          min-height: 410px;
          border: 1px solid rgba(255, 255, 255, 0.045);
          border-radius: 21px;
          background:
            radial-gradient(
              circle at 50% 45%,
              rgba(124, 58, 237, 0.12),
              transparent 40%
            ),
            rgba(1, 3, 16, 0.7);
          padding: 20px;
          display: flex;
          align-items: center;
          justify-content: center;
          position: relative;
          overflow: hidden;
        }

        .preview-glow {
          position: absolute;
          width: 180px;
          height: 180px;
          border-radius: 50%;
          background: rgba(124, 58, 237, 0.12);
          filter: blur(70px);
        }

        .preview-canvas {
          width: min(100%, 320px);
          max-height: 365px;
          min-height: 170px;
          border: 1px solid rgba(168, 85, 247, 0.18);
          border-radius: 17px;
          background:
            linear-gradient(
              145deg,
              rgba(168, 85, 247, 0.055),
              rgba(30, 41, 59, 0.025)
            ),
            #05071a;
          display: flex;
          align-items: center;
          justify-content: center;
          position: relative;
          z-index: 2;
          overflow: hidden;
          box-shadow:
            0 18px 45px rgba(0, 0, 0, 0.25),
            0 0 35px rgba(124, 58, 237, 0.07);
        }

        .empty-state,
        .loading-state {
          padding: 20px;
          text-align: center;
          display: flex;
          flex-direction: column;
          align-items: center;
        }

        .magic-icon {
          width: 54px;
          height: 54px;
          display: grid;
          place-items: center;
          border-radius: 17px;
          color: #d8b4fe;
          font-size: 24px;
          background: rgba(168, 85, 247, 0.08);
          box-shadow: 0 0 35px rgba(168, 85, 247, 0.08);
        }

        .empty-state h3,
        .loading-state h3 {
          margin: 16px 0 7px;
          font-size: 12px;
          font-weight: 500;
        }

        .empty-state p,
        .loading-state p {
          margin: 0;
          max-width: 220px;
          color: #625e71;
          font-size: 9px;
          line-height: 1.9;
        }

        .loader {
          width: 42px;
          height: 42px;
          border-radius: 50%;
          border: 2px solid rgba(168, 85, 247, 0.15);
          border-top-color: #a855f7;
          animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
          to {
            transform: rotate(360deg);
          }
        }

        .preview-details {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 8px;
          margin-top: 13px;
        }

        .preview-details > div {
          min-height: 65px;
          border: 1px solid rgba(255, 255, 255, 0.045);
          border-radius: 14px;
          background: rgba(255, 255, 255, 0.014);
          padding: 11px;
          display: flex;
          flex-direction: colum;
  justify-content: center;
  gap: 6px;
}

.preview-details small {
  color: #5e596b;
  font-size: 7px;
}

.preview-details b {
  font-size: 9px;
  direction: ltr;
  text-align: right;
}

.tip {
  margin-top: 13px;
  border: 1px solid rgba(168, 85, 247, 0.08);
  border-radius: 14px;
  background: rgba(124, 58, 237, 0.035);
  padding: 12px;
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.tip span {
  font-size: 13px;
}

.tip p {
  margin: 0;
  color: #686275;
  font-size: 8px;
  line-height: 1.9;
}

@media (max-width: 900px) {
  .workspace {
    grid-template-columns: 1fr;
    max-width: 700px;
  }

  .preview-panel {
    position: relative;
    top: auto;
  }

  .preview-stage {
    min-height: 350px;
  }
}

@media (max-width: 650px) {
  .create-page {
    padding-bottom: 45px;
  }

  .topbar {
    width: calc(100% - 28px);
    height: 82px;
  }

  .brand img {
    width: 92px;
  }

  .top-actions {
    gap: 10px;
  }

  .account-link {
    font-size: 12px;
  }

  .credit-pill {
    min-width: 104px;
    min-height: 50px;
    border-radius: 14px;
    padding: 7px 9px;
  }

  .credit-star {
    width: 28px;
    height: 28px;
  }

  .intro {
    width: calc(100% - 30px);
    margin: 48px auto 32px;
  }

  .intro h1 {
    font-size: 36px;
    line-height: 1.5;
  }

  .intro p {
    font-size: 11px;
  }

  .workspace {
    width: calc(100% - 24px);
  }

  .control-panel,
  .preview-panel {
    border-radius: 22px;
  }

  .control-panel {
    padding: 18px;
  }

  .quality-grid {
    grid-template-columns: 1fr 1fr;
  }

  .quality-card {
    min-height: 104px;
    padding: 12px;
    grid-template-columns: 37px 1fr;
    gap: 8px;
  }

  .quality-icon {
    width: 37px;
    height: 37px;
  }

  .ratio-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .square-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ratio-card {
    min-height: 112px;
  }

  .count-price-row {
    grid-template-columns: 1fr;
  }

  .count-selector {
    min-height: 70px;
  }

  .preview-stage {
    min-height: 320px;
  }

  .preview-details {
    grid-template-columns: 1fr 1fr;
  }

  .preview-details > div:last-child {
    grid-column: 1 / -1;
  }
}

@media (max-width: 390px) {
  .topbar {
    width: calc(100% - 20px);
  }

  .brand img {
    width: 82px;
  }

  .account-link {
    display: none;
  }

  .credit-pill {
    min-width: 98px;
  }

  .intro h1 {
    font-size: 31px;
  }

  .control-panel {
    padding: 15px;
  }

  .quality-grid {
    grid-template-columns: 1fr;
  }

  .ratio-grid,
  .square-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .custom-inputs {
    grid-template-columns: 1fr;
  }

  .size-x {
    display: none;
  }

  .custom-presets {
    flex-direction: column;
  }

  .custom-presets button {
    width: 100%;
  }

  .generate-btn {
    min-height: 65px;
  }
}
      `}</style>
</main>
  );
}
