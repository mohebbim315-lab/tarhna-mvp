"use client";

import { useMemo, useState } from "react";

type RatioOption = {
  id: string;
  title: string;
  ratio: string;
  width: number;
  height: number;
  group: "square" | "portrait" | "landscape";
};

const ratioOptions: RatioOption[] = [
  { id: "1-1", title: "مربع", ratio: "1:1", width: 1, height: 1, group: "square" },

  { id: "4-5", title: "پست اینستاگرام", ratio: "4:5", width: 4, height: 5, group: "portrait" },
  { id: "3-4", title: "عمودی", ratio: "3:4", width: 3, height: 4, group: "portrait" },
  { id: "2-3", title: "پرتره", ratio: "2:3", width: 2, height: 3, group: "portrait" },
  { id: "9-16", title: "استوری و ریلز", ratio: "9:16", width: 9, height: 16, group: "portrait" },

  { id: "5-4", title: "افقی کوتاه", ratio: "5:4", width: 5, height: 4, group: "landscape" },
  { id: "4-3", title: "افقی کلاسیک", ratio: "4:3", width: 4, height: 3, group: "landscape" },
  { id: "3-2", title: "عکاسی", ratio: "3:2", width: 3, height: 2, group: "landscape" },
  { id: "16-9", title: "یوتیوب", ratio: "16:9", width: 16, height: 9, group: "landscape" },
  { id: "21-9", title: "سینمایی", ratio: "21:9", width: 21, height: 9, group: "landscape" },
];

export default function CreatePage() {
  const [prompt, setPrompt] = useState("");
  const [quality, setQuality] = useState<"normal" | "pro">("normal");
  const [selectedRatio, setSelectedRatio] = useState("1-1");
  const [customMode, setCustomMode] = useState(false);
  const [customWidth, setCustomWidth] = useState(1024);
  const [customHeight, setCustomHeight] = useState(1024);
  const [count, setCount] = useState(1);
  const [generating, setGenerating] = useState(false);

  const activeRatio = useMemo(
    () => ratioOptions.find((item) => item.id === selectedRatio) ?? ratioOptions[0],
    [selectedRatio]
  );

  const pricePerImage = quality === "normal" ? 2500 : 5000;
  const totalPrice = pricePerImage * count;

  const previewRatio = customMode
  ? `${customWidth} / ${customHeight}`
  : `${activeRatio.width} / ${activeRatio.height}`;

  function chooseRatio(id: string) {
    setSelectedRatio(id);
    setCustomMode(false);
  }

  function generateImage() {
    if (!prompt.trim()) return;

    setGenerating(true);

    setTimeout(() => {
      setGenerating(false);
    }, 1800);
  }

  return (
    <main className="create-page" dir="rtl">
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="topbar">
        <a href="/" className="brand" aria-label="طرحنا">
          <img src="/images/tarhna-logo.png" alt="طرحنا" />
        </a>

        <div className="top-actions">
          <div className="credit-pill">
            <span className="credit-star">✦</span>
            <div>
              <small>اعتبار شما</small>
              <b>۵۰ اعتبار</b>
            </div>
          </div>

          <a href="/dashboard" className="account-link">
            حساب کاربری
          </a>
        </div>
      </header>

      <section className="intro">
        <div className="eyebrow">
          <span>✦</span>
          استودیوی هوش مصنوعی طرحنا
        </div>

        <h1>
          ایده‌ات را به
          <span> تصویر تبدیل کن</span>
        </h1>

        <p>
          هر چیزی که در ذهن داری توصیف کن؛ طرحنا آن را به یک تصویر
          حرفه‌ای تبدیل می‌کند.
        </p>
      </section>

      <section className="workspace">
        <div className="control-panel">
          <div className="section-title">
            <span className="step">01</span>
            <div>
              <h2>ایده‌ات را بنویس</h2>
              <p>هرچقدر دقیق‌تر توضیح بدهی، نتیجه بهتر می‌شود.</p>
            </div>
          </div>

          <div className="prompt-box">
            <span className="prompt-label">AI PROMPT</span>

            <textarea
              value={prompt}
              maxLength={1200}
              onChange={(e) => setPrompt(e.target.value)}
              placeholder="مثلاً: یک شهر آینده‌نگر ایرانی در شب، معماری مدرن، نورهای نئونی بنفش و آبی، نمای سینمایی..."
            />

            <div className="prompt-footer">
              <button type="button" className="enhance-btn">
                ✦ بهبود پرامپت
              </button>

              <span>{prompt.length} / 1200</span>
            </div>
          </div>

          <div className="divider" />

          <div className="section-title">
            <span className="step">02</span>
            <div>
              <h2>کیفیت تصویر</h2>
              <p>مدل مناسب برای خروجی خودت را انتخاب کن.</p>
            </div>
          </div>

          <div className="quality-grid">
            <button
              type="button"
              className={"quality-card " + (quality === "normal" ? "active" : "")}
              onClick={() => setQuality("normal")}
            >
              <span className="quality-icon">✦</span>
              <div>
                <b>معمولی</b>
                <small>سریع و اقتصادی</small>
              </div>
              <strong>۲,۵۰۰ تومان</strong>
            </button>

            <button
              type="button"
              className={"quality-card " + (quality === "pro" ? "active" : "")}
              onClick={() => setQuality("pro")}
            >
              <span className="quality-icon">◆</span>
              <div>
                <b>حرفه‌ای</b>
                <small>جزئیات و کیفیت بیشتر</small>
              </div>
              <strong>۵,۰۰۰ تومان</strong>
            </button>
          </div>

          <div className="divider" />

          <div className="section-title ratio-title">
            <span className="step">03</span>
            <div>
              <h2>نسبت و اندازه تصویر</h2>
              <p>ابعاد مناسب خروجی را انتخاب کن.</p>
            </div>
          </div>
          <div className="ratio-section">
            <div className="ratio-group">
              <div className="group-label">
                <span>▣</span>
                <b>مربع</b>
              </div>

              <div className="ratio-grid square-grid">
                {ratioOptions
                  .filter((item) => item.group === "square")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                      className={"ratio-card " + (
                        !customMode && selectedRatio === item.id  ? "active" : "")
                      }
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                            aspectRatio: `${item.width}/${item.height},
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <div className="ratio-group">
              <div className="group-label">
                <span>▯</span>
                <b>عمودی</b>
              </div>

              <div className="ratio-grid">
                {ratioOptions
                  .filter((item) => item.group === "portrait")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                      className={"ratio-card " + (
                        !customMode && selectedRatio === item.id  ? "active" : "")
                      }}
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                    aspectRatio: item.width + " / " + item.height,
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <div className="ratio-group">
              <div className="group-label">
                <span>▭</span>
                <b>افقی</b>
              </div>

              <div className="ratio-grid">
                {ratioOptions
                  .filter((item) => item.group === "landscape")
                  .map((item) => (
                    <button
                      key={item.id}
                      type="button"
                      onClick={() => chooseRatio(item.id)}
                      className={"ratio-card " + (
                        !customMode && selectedRatio === item.id  ? "active" : "")
                      }}
                    >
                      <div className="ratio-shape-wrap">
                        <span
                          className="ratio-shape"
                          style={{
                    aspectRatio: item.width + " / " + item.height,
                          }}
                        />
                      </div>

                      <div className="ratio-text">
                        <b>{item.ratio}</b>
                        <small>{item.title}</small>
                      </div>

                      {!customMode && selectedRatio === item.id && (
                        <span className="selected-check">✓</span>
                      )}
                    </button>
                  ))}
              </div>
            </div>

            <button
              type="button"
              className={"custom-size-card " + (customMode ? "active" : "")}
              onClick={() => setCustomMode(true)}
            >
              <div className="custom-icon">⌗</div>

              <div className="custom-copy">
                <b>اندازه دلخواه</b>
                <small>عرض و ارتفاع تصویر را خودت مشخص کن</small>
              </div>

              <span className="custom-arrow">←</span>
            </button>

            {customMode && (
              <div className="custom-panel">
                <div className="custom-panel-head">
                  <div>
                    <b>ابعاد اختصاصی</b>
                    <small>اندازه خروجی را به پیکسل وارد کن</small>
                  </div>

                  <span>Custom Size</span>
                </div>

                <div className="custom-inputs">
                  <label>
                    <span>عرض</span>
                    <div>
                      <input
                        type="number"
                        min="256"
                        max="4096"
                        value={customWidth}
                        onChange={(e) =>
                          setCustomWidth(
                            Math.max(256, Number(e.target.value) || 256)
                          )
                        }
                      />
                      <small>px</small>
                    </div>
                  </label>

                  <span className="size-x">×</span>

                  <label>
                    <span>ارتفاع</span>
                    <div>
                      <input
                        type="number"
                        min="256"
                        max="4096"
                        value={customHeight}
                        onChange={(e) =>
                          setCustomHeight(
                            Math.max(256, Number(e.target.value) || 256)
                          )
                        }
                      />
                      <small>px</small>
                    </div>
                  </label>
                </div>

                <div className="custom-presets">
                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1080);
                      setCustomHeight(1920);
                    }}
                  >
                    استوری 1080×1920
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1920);
                      setCustomHeight(1080);
                    }}
                  >
                    Full HD 1920×1080
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      setCustomWidth(1080);
                      setCustomHeight(1350);
                    }}
                  >
                    پست 1080×1350
                  </button>
                </div>
              </div>
            )}
          </div>

          <div className="divider" />

          <div className="section-title">
            <span className="step">04</span>
            <div>
              <h2>تعداد تصاویر</h2>
              <p>چند خروجی متفاوت می‌خواهی؟</p>
            </div>
          </div>

          <div className="count-price-row">
            <div className="count-selector">
              <button
                type="button"
                onClick={() => setCount((value) => Math.max(1, value - 1))}
                disabled={count <= 1}
              >
                −
              </button>

              <div>
                <b>{count}</b>
                <small>تصویر</small>
              </div>

              <button
                type="button"
                onClick={() => setCount((value) => Math.min(4, value + 1))}
                disabled={count >= 4}
              >
                +
              </button>
            </div>

            <div className="price-box">
              <small>هزینه تولید</small>
              <b>{totalPrice.toLocaleString("fa-IR")} تومان</b>
              <span>
                {quality === "normal" ? "کیفیت معمولی" : "کیفیت حرفه‌ای"} ×{" "}
                {count}
              </span>
            </div>
          </div>

          <button
            type="button"
            className="generate-btn"
            onClick={generateImage}
            disabled={generating || !prompt.trim()}
          >
            <span className="generate-icon">✦</span>

            <span>
              <b>{generating ? "در حال ساخت تصویر..." : "تولید تصویر"}</b>
              <small>
                {prompt.trim()
            ? count + " خروجی • " + totalPrice.toLocaleString("fa-IR") + " تومان"
            : "پرامپت را آماده کن"}
              </small>
            </span>

            <span className="generate-arrow">←</span>
          </button>
        </div>

        <aside className="preview-panel">
          <div className="preview-head">
            <div>
              <span className="live-dot" />
              <b>پیش‌نمایش خروجی</b>
            </div>

            <span className="preview-ratio">
              {customMode
              ? customWidth + "×" + customHeight
                : activeRatio.ratio}
            </span>
          </div>

          <div className="preview-stage">
            <div className="preview-glow" />

            <div
              className="preview-canvas"
              style={{
                aspectRatio: previewRatio,
              }}
            >
              {generating ? (
                <div className="loading-state">
                  <div className="loader" />
                  <h3>در حال خلق تصویر...</h3>
                  <p>هوش مصنوعی طرحنا در حال پردازش ایده توست.</p>
                </div>
              ) : (
                <div className="empty-state">
                  <div className="magic-icon">✦</div>
                  <h3>تصویر تو اینجا ساخته می‌شود</h3>
                  <p>
                    پرامپت، کیفیت و ابعاد را انتخاب کن و دکمه تولید را بزن.
                  </p>
                </div>
              )}
            </div>
          </div>

          <div className="preview-details">
            <div>
              <small>مدل</small>
              <b>
                {quality === "normal" ? "Tarhna Standard" : "Tarhna Pro"}
              </b>
            </div>

            <div>
              <small>تعداد</small>
              <b>{count} تصویر</b>
            </div>

            <div>
              <small>ابعاد</small>
              <b>
                {customMode
                ? customWidth + " × " + customHeight
                  : activeRatio.ratio}
              </b>
            </div>
          </div>

          <div className="tip">
            <span>💡</span>
            <p>
              برای نتیجه بهتر، درباره نور، سبک، زاویه دوربین و جزئیات صحنه
              توضیح بده.
            </p>
          </div>
        </aside>
      </section>

      <style jsx>{`
        * {
          box-sizing: border-box;
        }

        .create-page {
          --bg: #030617;
          --panel: rgba(8, 10, 34, 0.82);
          --panel-2: rgba(15, 12, 48, 0.68);
          --border: rgba(168, 85, 247, 0.16);
          --border-soft: rgba(255, 255, 255, 0.07);
          --text: #f8f5ff;
          --muted: #77748e;
          --purple: #a855f7;
          --purple-2: #7c3aed;
          --pink: #d946ef;

          min-height: 100vh;
          position: relative;
          overflow: hidden;
          background:
            radial-gradient(
              circle at 78% 5%,
              rgba(88, 28, 135, 0.2),
              transparent 29%
            ),
            radial-gradient(
              circle at 10% 60%,
              rgba(30, 64, 175, 0.08),
              transparent 28%
            ),
            var(--bg);
          color: var(--text);
          font-family: Arial, sans-serif;
          padding-bottom: 80px;
        }

        .ambient {
          position: absolute;
          border-radius: 999px;
          filter: blur(100px);
          pointer-events: none;
        }

        .ambient-one {
          width: 360px;
          height: 360px;
          top: -160px;
          right: 10%;
          background: rgba(124, 58, 237, 0.12);
        }

        .ambient-two {
          width: 300px;
          height: 300px;
          top: 700px;
          left: -170px;
          background: rgba(59, 130, 246, 0.06);
        }

        .topbar {
          width: min(1180px, calc(100% - 40px));
          height: 96px;
          margin: 0 auto;
          display: flex;
          align-items: center;
          justify-content: space-between;
          border-bottom: 1px solid rgba(255, 255, 255, 0.035);
          position: relative;
          z-index: 5;
        }

        .brand {
          display: flex;
          align-items: center;
          justify-content: center;
          text-decoration: none;
          background: transparent;
          border: 0;
          padding: 0;
        }

        .brand img {
          width: 116px;
          height: auto;
          display: block;
          object-fit: contain;
          background: transparent;
          border: 0;
          border-radius: 0;
          box-shadow: none;
        }

        .top-actions {
          display: flex;
          align-items: center;
          gap: 22px;
        }

        .account-link {
          color: #e7e2f3;
          text-decoration: none;
          font-size: 14px;
        }

        .credit-pill {
          min-width: 130px;
          min-height: 57px;
          border: 1px solid rgba(168, 85, 247, 0.24);
          border-radius: 17px;
          padding: 9px 13px;
          display: flex;
          align-items: center;
          gap: 10px;
          background: linear-gradient(
            135deg,
            rgba(124, 58, 237, 0.15),
            rgba(88, 28, 135, 0.05)
          );
        }

        .credit-star {
          width: 31px;
          height: 31px;
          border-radius: 10px;
          display: grid;
          place-items: center;
          color: #d8b4fe;
          background: rgba(168, 85, 247, 0.12);
        }

        .credit-pill div {
          display: flex;
          flex-direction: column;
          gap: 3px;
        }

        .credit-pill small {
          color: #7e7991;
          font-size: 9px;
        }

        .credit-pill b {
          font-size: 11px;
          font-weight: 600;
        }

        .intro {
          width: min(900px, calc(100% - 40px));
          margin: 68px auto 43px;
          text-align: center;
          position: relative;
          z-index: 2;
        }

        .eyebrow {
          width: fit-content;
          margin: 0 auto 24px;
          border: 1px solid rgba(168, 85, 247, 0.2);
          border-radius: 999px;
          background: rgba(124, 58, 237, 0.07);
          padding: 10px 17px;
          color: #9b92af;
          font-size: 11px;
        }

        .eyebrow span {
          color: #c084fc;
          margin-left: 6px;
        }

        .intro h1 {
          margin: 0;
          font-size: clamp(38px, 5vw, 62px);
          line-height: 1.35;
          letter-spacing: -1px;
        }

        .intro h1 span {
          background: linear-gradient(90deg, #d946ef, #8b5cf6, #60a5fa);
          -webkit-background-clip: text;
          background-clip: text;
          color: transparent;
        }

        .intro p {
          margin: 20px auto 0;
          max-width: 660px;
          color: #77748c;
          font-size: 13px;
          line-height: 2;
        }

        .workspace {
          width: min(1180px, calc(100% - 40px));
          margin: 0 auto;
          display: grid;
          grid-template-columns: minmax(0, 1.2fr) minmax(330px, 0.8fr);
          gap: 22px;
          align-items: start;
          position: relative;
          z-index: 2;
        }
        .control-panel,
        .preview-panel {
          border: 1px solid var(--border-soft);
          border-radius: 28px;
          background:
            linear-gradient(
              145deg,
              rgba(13, 14, 42, 0.9),
              rgba(5, 7, 27, 0.88)
            );
          box-shadow:
            0 30px 80px rgba(0, 0, 0, 0.18),
            inset 0 1px 0 rgba(255, 255, 255, 0.025);
          backdrop-filter: blur(18px);
        }

        .control-panel {
          padding: 30px;
        }

        .section-title {
          display: flex;
          align-items: center;
          gap: 15px;
          margin-bottom: 20px;
        }

        .step {
          width: 45px;
          height: 45px;
          flex: 0 0 45px;
          border-radius: 14px;
          display: grid;
          place-items: center;
          border: 1px solid rgba(168, 85, 247, 0.18);
          background: rgba(124, 58, 237, 0.08);
          color: #b88cff;
          font-size: 10px;
        }

        .section-title h2 {
          margin: 0 0 6px;
          font-size: 17px;
          font-weight: 600;
        }

        .section-title p {
          margin: 0;
          color: var(--muted);
          font-size: 10px;
        }

        .prompt-box {
          position: relative;
          min-height: 200px;
          border: 1px solid rgba(168, 85, 247, 0.12);
          border-radius: 22px;
          background: rgba(2, 4, 20, 0.6);
          overflow: hidden;
        }

        .prompt-box:focus-within {
          border-color: rgba(168, 85, 247, 0.38);
          box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.04);
        }

        .prompt-box textarea {
          width: 100%;
          min-height: 200px;
          resize: vertical;
          border: 0;
          outline: 0;
          background: transparent;
          color: #f4efff;
          padding: 22px 22px 55px;
          font-family: inherit;
          font-size: 13px;
          line-height: 2;
        }

        .prompt-box textarea::placeholder {
          color: #4f4d63;
        }

        .prompt-bottom {
          position: absolute;
          right: 17px;
          left: 17px;
          bottom: 14px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          pointer-events: none;
        }

        .prompt-bottom span {
          color: #555268;
          font-size: 9px;
        }

        .enhance-btn {
          pointer-events: auto;
          border: 1px solid rgba(168, 85, 247, 0.16);
          border-radius: 10px;
          background: rgba(124, 58, 237, 0.07);
          color: #9d7ac8;
          min-height: 34px;
          padding: 0 12px;
          font-family: inherit;
          font-size: 9px;
          cursor: pointer;
        }

        .enhance-btn:disabled {
          opacity: 0.4;
          cursor: not-allowed;
        }

        .divider {
          height: 1px;
          background: rgba(255, 255, 255, 0.045);
          margin: 30px 0;
        }

        .quality-grid {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 13px;
