"use client";
import InteractiveCube from "./InteractiveCube";

import Link from "next/link";
import { useState } from "react"
type IconProps = { size?: number };

function Spark({ size = 18 }: IconProps) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><path d="M12 2l1.9 6.1L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.9L12 2Z" stroke="currentColor" strokeWidth="1.7"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z" fill="currentColor"/></svg>;
}
function ImageIcon({ size = 24 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="3" stroke="currentColor" strokeWidth="1.6"/><circle cx="8.5" cy="9" r="1.5" fill="currentColor"/><path d="m5.5 17 4.4-4.1 2.8 2.5 2.1-2 3.7 3.6" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round"/></svg>; }
function PenIcon({ size = 24 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><path d="m4 20 4.2-1 10.9-10.9a2.3 2.3 0 0 0-3.2-3.2L5 15.8 4 20Z" stroke="currentColor" strokeWidth="1.6"/><path d="m13.9 6.1 4 4" stroke="currentColor" strokeWidth="1.6"/><path d="M4 20h4" stroke="currentColor" strokeWidth="1.6"/></svg>; }
function LogoIcon({ size = 24 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" strokeWidth="1.6"/><path d="M7 15V9h2.5c2.8 0 4.6 1 4.6 3s-1.8 3-4.6 3H7Zm0-3h2.2c1.4 0 2.1-.3 2.1-1s-.7-1-2.1-1H7" stroke="currentColor" strokeWidth="1.5"/><path d="M15.5 15V9H19" stroke="currentColor" strokeWidth="1.5"/></svg>; }
function EditIcon({ size = 24 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><path d="m5 16-1 4 4-1L19 8l-3-3L5 16Z" stroke="currentColor" strokeWidth="1.6"/><path d="m14 6 3 3" stroke="currentColor" strokeWidth="1.6"/><path d="M4 4h7" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/></svg>; }
function CrownIcon({ size = 24 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><path d="m4 8 4 3 4-6 4 6 4-3-1.5 10H5.5L4 8Z" stroke="currentColor" strokeWidth="1.6" strokeLinejoin="round"/><path d="M6 21h12" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round"/></svg>; }
function BellIcon({ size = 20 }: IconProps) { return <svg width={size} height={size} viewBox="0 0 24 24" fill="none"><path d="M6 10a6 6 0 0 1 12 0c0 6 2 6 2 7H4c0-1 2-1 2-7Z" stroke="currentColor" strokeWidth="1.5"/><path d="M10 20h4" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round"/></svg>; }
function Chevron({ left = false }: { left?: boolean }) { return <svg width="16" height="16" viewBox="0 0 24 24" fill="none" className={left ? "flip" : ""}><path d="m9 18 6-6-6-6" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"/></svg>; }

const services = [
  { title: "سفارش اختصاصی", desc: "سفارشی دقیقاً مطابق نیاز شما", icon: <CrownIcon />, tone: "gold", href: "/poster" },
  { title: "فرآیند تصویر", desc: "بهبود، ترکیب و تبدیل تصاویر", icon: <EditIcon />, tone: "pink", href: "/edit" },
  { title: "طراحی لوگو", desc: "لوگوی اختصاصی برند شما", icon: <LogoIcon />, tone: "blue", href: "/logo" },
  { title: "طراحی پوستر", desc: "پوسترهای حرفه‌ای و خلاقانه", icon: <PenIcon />, tone: "purple", href: "/poster" },
  { title: "ویرایش تصویر", desc: "اصلاح و بازطراحی تصویر", icon: <EditIcon />, tone: "cyan", href: "/edit" },
  { title: "ساخت تصویر با AI", desc: "ایده‌ات را به تصویر تبدیل کن", icon: <ImageIcon />, tone: "violet", href: "/create" },
];

const artworks = [
  { title: "Cinematic Portrait", user: "arya.design", likes: "2.1K", views: "16.6K", image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=700&q=85" },
  { title: "Luxury Product", user: "fatemeh_ai", likes: "1.8K", views: "12.3K", image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=700&q=85" },
  { title: "Fantasy World", user: "mohsen_art", likes: "2.6K", views: "21.1K", image: "https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=700&q=85" },
  { title: "Anime Concept", user: "hosein.d", likes: "3.7K", views: "28.9K", image: "https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=700&q=85" },
  { title: "Magic Castle", user: "negar.ai", likes: "2.4K", views: "18.7K", image: "https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=700&q=85" },
  { title: "Architectural", user: "design.room", likes: "1.6K", views: "11.2K", image: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=700&q=85" },
];

const prompts = [
  { title: "Cinematic Portrait", category: "چهره", price: "۲۹,۰۰۰", rating: "4.9", image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=600&q=85" },
  { title: "Luxury Product", category: "محصول", price: "۱۹,۰۰۰", rating: "4.8", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=85" },
  { title: "Fantasy World", category: "فانتزی", price: "۲۹,۰۰۰", rating: "4.9", image: "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=85" },
  { title: "Architectural", category: "معماری", price: "۲۲,۰۰۰", rating: "4.7", image: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=600&q=85" },
];

function Brand({ dark = true }: { dark?: boolean }) {
  return (
    <div className="brand tarhna-brand">
      <img
        src="/images/tarhna-header-logo.png"
        alt="طرحنا""
        draggable={false}
      />
      <span className="tarhna-brand-en">Tarhna</span>
    </div>
  );
}

export default function Home() {
  const [dark, setDark] = useState(true);

  return (
    <main className={dark ? "site dark" : "site light"}>
      <div className="ambient ambient-one" />
      <div className="ambient ambient-two" />

      <header className="topbar wrap">
        <Brand dark={dark} />
        <nav className="nav">
          <Link className="active" href="/">خانه</Link>
          <Link href="/create">ساخت تصویر</Link>
          <Link href="/poster">طراحی پوستر</Link>
          <Link href="/logo">طراحی لوگو</Link>
          <Link href="/prompts">پرامپت‌ها</Link>
          <Link href="/gallery">گالری</Link>
          <Link href="/dashboard">بیشتر⌄</Link>
        </nav>
        <div className="top-actions">
          <button className="theme-switch" onClick={() => setDark(!dark)} aria-label="تغییر حالت نمایش"><span>☾</span><span>☀</span></button>
          <div className="credits">💎 اعتبار: <b>۱,۳۵۰</b></div>
          <button className="icon-btn"><BellIcon /></button>
          <Link href="/dashboard" className="avatar">ط</Link>
        </div>
      </header>

      <section className="hero wrap">
        <div className="hero-copy">
          <div className="eyebrow"><Spark size={15} /> ۵۰ اعتبار رایگان برای شروع <span>🎁</span></div>
          <h1>ایده‌ات را <em>به واقعیت</em><br />تبدیل کن</h1>
          <p>با هوش مصنوعی، ضعیف‌ترین ایده‌ها را به تصاویر خلاقانه و منحصر‌به‌فرد بساز؛ و رویاهای خودت را واقعی کن.</p>
          <div className="hero-actions">
            <Link href="/create" className="primary-btn"><Spark size={16} /> شروع ساخت تصویر</Link>
            <Link href="/gallery" className="secondary-btn">مشاهده نمونه‌ها <Chevron left /></Link>
          </div>
        </div>

      <div className="hero-stage" aria-label="مکعب سه‌بعدی تعاملی">
        <InteractiveCube />
      </div>
      </section>

      <section className="creator wrap glass-panel">
        <div className="creator-main">
          <h3>چه چیزی می‌خواهی بسازی؟</h3>
          <div className="prompt-row">
            <Link href="/create" className="prompt-submit"><Spark size={16} /> ساخت تصویر</Link>
            <div className="prompt-input">توضیح بده چه تصویری در ذهن داری...</div>
          </div>
          <div className="chips">
            {['همه سبک‌ها','فانتزی','سینمایی','هنری','فتورئال','سه‌بعدی','مینیمال','تبلیغاتی'].map((x,i)=><button key={x} className={i===0?'selected':''}>{x} {i===0?'✦':''}</button>)}
          </div>
        </div>
        <div className="creator-options">
          <div className="ratio-title">نسبت تصویر</div>
          <div className="ratios">
            {['1:1','16:9','9:16','4:3'].map((x,i)=><div className={i === 1 ? 'ratio selected' : 'ratio'} key={x}><div className="ratio-box r-{i}"></div><span>{x}</span></div>)}
          </div>
          <div className="quality"><span>کیفیت خروجی</span><button>استاندارد</button><button className="selected">حرفه‌ای ✦</button></div>
        </div>
      </section>

      <section className="services wrap">
        {services.map((s)=><Link href={s.href} className={`service-card ${s.tone}`} key={s.title}><div className="service-icon">{s.icon}</div><div><h3>{s.title}</h3><p>{s.desc}</p></div></Link>)}
      </section>

      <section className="section wrap">
        <div className="section-head"><div><span className="section-kicker">گالری اجتماعی</span><h2>🔥 آثار محبوب کاربران</h2></div><Link href="/gallery">مشاهده همه <Chevron /></Link></div>
        <div className="art-grid">
          {artworks.map((a)=><article className="art-card" key={a.title}><div className="art-image" style={{backgroundImage:`url(${a.image})`}}><div className="art-stats"><span>♡ {a.likes}</span><span>◉ {a.views}</span></div></div><div className="art-meta"><div><b>{a.title}</b><small>@{a.user}</small></div><span className="mini-avatar">{a.user[0]}</span></div></article>)}
        </div>
      </section>

      <section className="market wrap">
        <div className="market-head"><div><span className="section-kicker">بازار پرامپت</span><h2>پرامپت‌های محبوب</h2></div><Link href="/prompts">مشاهده همه</Link></div>
        <div className="market-grid">
          <div className="prompt-products">
            {prompts.map(p=><article className="prompt-card" key={p.title}><div className="prompt-cover" style={{backgroundImage:`url(${p.image})`}}><span>{p.category}</span></div><div className="prompt-info"><h3>{p.title}</h3><div className="prompt-bottom"><b>تومان {p.price}</b><span>★ {p.rating}</span></div></div></article>)}
          </div>
          <div className="packages">
            <div className="package-head"><span>اعتبار مورد نیازت را انتخاب کن</span><small>پرداخت امن و سریع</small></div>
            <div className="package-list">
              {[['شروع','۵۰ اعتبار','رایگان'],['اقتصادی','۱۰۰ اعتبار','۴۹,۰۰۰ تومان'],['حرفه‌ای','۵۰۰ اعتبار','۲۹۹,۰۰۰ تومان'],['ویژه','۱۰۰۰ اعتبار','۴۹۹,۰۰۰ تومان']].map((p,i)=><div className={`package ${i===2?'featured':''}`} key={p[0]}><small>{p[0]}</small><strong>{p[1]}</strong><b>{p[2]}</b><button>{i===0?'فعال‌سازی':'خرید بسته'}</button></div>)}
            </div>
          </div>
        </div>
      </section>

      <section className="stats wrap glass-panel">
        <div><span>⚡</span><b>۱۲,۴۵۰+</b><small>کاربر فعال</small></div>
        <div><span>◯</span><b>۲,۴۵۷,۷۸۹+</b><small>تصویر ساخته شده</small></div>
        <div><span>✦</span><b>۸,۹۷۶+</b><small>پرامپت فروخته شده</small></div>
        <div><span>☺</span><b>۹۸٪</b><small>رضایت کاربران</small></div>
      </section>

      <section className="trust wrap">
        <div><span>♥</span><b>ساخته شده در ایران</b><small>با عشق برای شما</small></div>
        <div><span>◈</span><b>پشتیبانی ۲۴/۷</b><small>همیشه کنار شما هستیم</small></div>
        <div><span>✓</span><b>امن و خصوصی</b><small>اطلاعات شما محفوظ است</small></div>
        <div><span>▣</span><b>قیمت مناسب</b><small>اعتبار بیشتر، هزینه کمتر</small></div>
        <div><span>✦</span><b>کیفیت فوق‌العاده</b><small>خروجی با بالاترین کیفیت</small></div>
        <div><span>♧</span><b>سریع و قدرتمند</b><small>تولید تصویر در چند ثانیه</small></div>
      </section>

      <footer className="footer wrap"><Brand dark={dark}/><p>طرحنا؛ جایی برای تبدیل ایده‌ها به واقعیت.</p><div><Link href="/create">ساخت تصویر</Link><Link href="/gallery">گالری</Link><Link href="/prompts">پرامپت‌ها</Link><Link href="/dashboard">حساب من</Link></div><small>© ۱۴۰۵ طرحنا — تمامی حقوق محفوظ است.</small></footer>
    </main>
  );
}
